{"vid": "iYJKd0rkKss", "model": "workbuddy-vps/cn:deepseek-v4.1-flash", "source": "iYJKd0rkKss.en.vtt", "cues": [{"s": 20.45, "e": 23.03, "zh": "回到荒野的感觉真好"}, {"s": 23.04, "e": 26.75, "zh": "再次来到这片似乎一切安宁的地方"}, {"s": 26.76, "e": 32.27, "zh": "我独自一人，只有我和动物们，这"}, {"s": 32.28, "e": 34.85, "zh": "种感觉太棒了，再次自由地"}, {"s": 34.86, "e": 38.87, "zh": "按自己的意愿计划、行动，这一切"}, {"s": 38.88, "e": 42.41, "zh": "都围绕着我，我的梦想不再是梦"}, {"s": 42.42, "e": 46.1, "zh": "我想我在这里，是因为这是"}, {"s": 46.11, "e": 48.92, "zh": "一件我必须做的事，不只是梦想"}, {"s": 48.93, "e": 52.7, "zh": "它，而是去做。我想，我也是"}, {"s": 52.71, "e": 55.52, "zh": "来这里检验自己。并不是我从未"}, {"s": 55.53, "e": 57.65, "zh": "做过，但这一次，它将是"}, {"s": 57.66, "e": 59.57, "zh": "一次更彻底、更持久的"}, {"s": 59.58, "e": 63.8, "zh": "检验：我到底能做什么，有哪些"}, {"s": 63.81, "e": 67.25, "zh": "我还不知道？我能真正享受"}, {"s": 67.26, "e": 71.27, "zh": "独处整整一年吗？我是否"}, {"s": 71.28, "e": 73.61, "zh": "能应对这片荒野可能"}, {"s": 73.62, "e": 77.42, "zh": "向我抛出的一切？我见过它在晚"}, {"s": 77.43, "e": 80.99, "zh": "春、夏和初秋的情绪，但"}, {"s": 81.0, "e": 83.48, "zh": "冬天呢？我会喜欢"}, {"s": 83.49, "e": 87.11, "zh": "那时的孤独吗？带着刺骨的"}, {"s": 87.12, "e": 92.6, "zh": "寒冷、幽灵般的寂静。51岁时，我"}, {"s": 92.61, "e": 96.37, "zh": "打算找出答案"}, {"s": 97.5, "e": 100.8, "zh": "又走了一百码，我走出"}, {"s": 100.81, "e": 103.11, "zh": "灌木丛，来到我那堆小屋原木前，那是我"}, {"s": 103.12, "e": 106.86, "zh": "去年七月弄来的。我坐下来，靠"}, {"s": 106.87, "e": 109.41, "zh": "在原木上，一边嚼着"}, {"s": 109.42, "e": 112.59, "zh": "一块烟熏鲑鱼，我的目光游移"}, {"s": 112.6, "e": 117.57, "zh": "扫过那些剥了皮的原木，那曾是"}, {"s": 117.58, "e": 120.57, "zh": "去年夏天的大工程，很辛苦，但我"}, {"s": 120.58, "e": 124.14, "zh": "很享受。木材旁很凉快"}, {"s": 124.15, "e": 126.66, "zh": "有些早晨我能看见自己"}, {"s": 126.67, "e": 127.26, "zh": "呼出的白气"}, {"s": 127.27, "e": 130.47, "zh": "那些原木是我从一片"}, {"s": 130.48, "e": 132.66, "zh": "云杉林里采来的，离它们现在"}, {"s": 132.67, "e": 155.85, "zh": "堆放的地方不到300码。这些原木是"}, {"s": 155.86, "e": 157.56, "zh": "现在比那时轻多了"}, {"s": 157.57, "e": 165.44, "zh": "而且用起来也够顺手"}, {"s": 165.45, "e": 169.2, "zh": "那是1968年晚春，"}, {"s": 169.21, "e": 171.75, "zh": "Dick Proenneke 决定离开"}, {"s": 171.76, "e": 174.24, "zh": "文明社会，住进一片"}, {"s": 174.25, "e": 177.09, "zh": "尚未被人类改变的原初之地，并"}, {"s": 177.1, "e": 180.0, "zh": "漫游一片荒野，那里很少有"}, {"s": 180.01, "e": 181.8, "zh": "其他人踏足"}, {"s": 181.81, "e": 184.29, "zh": "同时在这片"}, {"s": 184.3, "e": 187.56, "zh": "叫 Twin Lakes 的偏远山谷开辟新生活，Dick"}, {"s": 187.57, "e": 190.41, "zh": "不仅每天写日记，还"}, {"s": 190.42, "e": 193.11, "zh": "要用摄像机记录他的阿拉斯加探险，借助"}, {"s": 193.12, "e": 198.93, "zh": "三脚架固定摄像机的帮助。是时候"}, {"s": 198.94, "e": 201.99, "zh": "继续上路了。我急着"}, {"s": 202.0, "e": 203.76, "zh": "赶到 Spike 的小屋，看看它是否"}, {"s": 203.77, "e": 206.25, "zh": "还是我去年九月离开时的样子"}, {"s": 212.19, "e": 215.31, "zh": "再走约500码，穿过云杉"}, {"s": 215.32, "e": 218.48, "zh": "和柳树丛，它就在那儿"}, {"s": 218.49, "e": 220.98, "zh": "风化的灰色驼鹿角"}, {"s": 220.99, "e": 222.69, "zh": "张开在屋脊"}, {"s": 222.7, "e": 227.04, "zh": "正下方，烟囱管上有个锡罐，"}, {"s": 227.05, "e": 233.55, "zh": "窗户用木板封着。小屋里有"}, {"s": 233.56, "e": 235.17, "zh": "安家所需的一切"}, {"s": 235.18, "e": 239.52, "zh": "直到我自己的小屋建成：一个好"}, {"s": 239.53, "e": 242.79, "zh": "炉子、两张床铺，屋顶也不"}, {"s": 242.8, "e": 248.46, "zh": "漏雨。我用一块云杉木"}, {"s": 248.47, "e": 250.83, "zh": "削出木槌头，在上面钻了个孔，"}, {"s": 250.84, "e": 253.86, "zh": "再装上柄。这会是个"}, {"s": 253.87, "e": 256.8, "zh": "好用的敲击工具，而且我不用"}, {"s": 256.81, "e": 263.88, "zh": "把它背进来也一样。那些"}, {"s": 263.89, "e": 265.83, "zh": "木钻用的手柄，"}, {"s": 265.84, "e": 269.18, "zh": "宽刃凿和锉刀也一样，"}, {"s": 269.19, "e": 271.83, "zh": "不装手柄时携带起来"}, {"s": 271.84, "e": 276.01, "zh": "要容易得多"}, {"s": 276.02, "e": 280.15, "zh": "我清理了灌木丛，还从海滩拖上来一些材料"}, {"s": 280.16, "e": 282.61, "zh": "砾石，铺到"}, {"s": 282.62, "e": 285.01, "zh": "几英寸深，面积大约20"}, {"s": 285.02, "e": 289.03, "zh": "英尺乘20英尺。我觉得自己做了最"}, {"s": 289.04, "e": 293.23, "zh": "好的选择。它会是11英尺乘"}, {"s": 293.24, "e": 296.14, "zh": "15英尺，前门会朝"}, {"s": 296.15, "e": 299.17, "zh": "西北，大窗会望"}, {"s": 299.18, "e": 304.48, "zh": "向湖面。一堆原木，该"}, {"s": 304.49, "e": 308.11, "zh": "先挑哪些下手，要让榫口"}, {"s": 308.12, "e": 311.32, "zh": "严丝合缝。急不得，锯出几道"}, {"s": 311.33, "e": 313.66, "zh": "口子，间隔一两英寸，几乎锯到"}, {"s": 313.67, "e": 316.57, "zh": "铅笔线，然后把木块砍掉"}, {"s": 316.58, "e": 317.32, "zh": "用斧子。"}, {"s": 317.33, "e": 320.95, "zh": "直到槽口大致成形，然后"}, {"s": 320.96, "e": 323.26, "zh": "就是收尾活，仔细地"}, {"s": 323.27, "e": 326.56, "zh": "定制贴合。我正好有干这活的"}, {"s": 326.57, "e": 327.86, "zh": "工具。"}, {"s": 392.75, "e": 394.9, "zh": "有一根原木尤其需要"}, {"s": 394.91, "e": 397.11, "zh": "大量削砍才能弄直。我"}, {"s": 397.12, "e": 399.88, "zh": "得说，白云杉用斧子和"}, {"s": 399.89, "e": 409.54, "zh": "拉刀加工很顺手，够做"}, {"s": 409.55, "e": 413.23, "zh": "座椅。活儿已经开工，明天"}, {"s": 413.24, "e": 415.0, "zh": "应该多干活、少"}, {"s": 415.01, "e": 416.17, "zh": "琢磨。"}, {"s": 423.89, "e": 426.7, "zh": "我悄无声息地沿着另一条"}, {"s": 426.71, "e": 427.2, "zh": "小路滑行。"}, {"s": 437.82, "e": 441.42, "zh": "小屋在成形，28根原木已"}, {"s": 441.43, "e": 442.37, "zh": "就位。"}, {"s": 442.38, "e": 445.71, "zh": "44根应该够用，除了山墙"}, {"s": 445.72, "e": 449.22, "zh": "两端和屋顶原木。看起来真"}, {"s": 449.23, "e": 451.11, "zh": "很乱，原木端头伸出老远"}, {"s": 451.12, "e": 454.5, "zh": "超过墙角，但我会把它们"}, {"s": 454.51, "e": 457.17, "zh": "之后削掉。急不得。"}, {"s": 457.18, "e": 459.72, "zh": "我不想让这些原木看起来像"}, {"s": 459.73, "e": 461.64, "zh": "有个童子军被放开来"}, {"s": 461.65, "e": 481.2, "zh": "拿着钝手斧对它们乱砍。终于回到"}, {"s": 481.21, "e": 483.93, "zh": "造小屋上。我毕竟是更好的木匠"}, {"s": 483.94, "e": 487.83, "zh": "比当农夫强。总之，38根原木已"}, {"s": 487.84, "e": 489.84, "zh": "就位，我差不多准备好做檐口"}, {"s": 489.85, "e": 491.03, "zh": "原木。"}, {"s": 491.04, "e": 493.74, "zh": "我要把大窗户的洞口开出来。"}, {"s": 493.75, "e": 496.74, "zh": "两根较小的，以及门洞的"}, {"s": 496.75, "e": 506.76, "zh": "开口。这五根原木很特别"}, {"s": 506.77, "e": 509.97, "zh": "这些是20英尺长的原木，它们连同"}, {"s": 509.98, "e": 511.32, "zh": "我们的山墙端一起，将成为"}, {"s": 511.33, "e": 514.83, "zh": "我屋顶的骨架。两根做檐"}, {"s": 514.84, "e": 518.22, "zh": "口原木，两根做檩条原木，最后"}, {"s": 518.23, "e": 520.35, "zh": "最直的一根做脊"}, {"s": 520.36, "e": 525.84, "zh": "木。现在这样看，小屋看起来"}, {"s": 525.85, "e": 527.97, "zh": "好像原木到处都伸出来"}, {"s": 527.98, "e": 532.7, "zh": "像豪猪的刺。我"}, {"s": 532.71, "e": 535.29, "zh": "今早醒来，惊讶地看到"}, {"s": 535.3, "e": 538.44, "zh": "地上有四英寸的雪。看起来"}, {"s": 538.45, "e": 540.48, "zh": "好像我刚好及时完成了壁炉"}, {"s": 540.49, "e": 545.57, "zh": "这是个寒冷的早晨，23度"}, {"s": 545.58, "e": 549.27, "zh": "我的冷藏箱里35度，湖水"}, {"s": 549.28, "e": 552.42, "zh": "42度，但压力已经"}, {"s": 552.43, "e": 556.2, "zh": "解除。壁炉建好了，剩下"}, {"s": 556.21, "e": 558.21, "zh": "的一点活儿都能完成"}, {"s": 558.22, "e": 561.36, "zh": "不管天气如何"}]}