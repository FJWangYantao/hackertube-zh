{"vid": "GdQKUvv3bew", "source": "deepgram", "model": "nova-3", "translation_model": "pool:[\"antigravity/gemini-3.8-flash\",\"codex/gpt-6-luna\",\"trae-cn/deepseek-v4.1-flash\",\"workbuddy-vps/cn:deepseek-v4.1-flash\"]", "translation_models": ["codex/gpt-6-luna", "antigravity/gemini-3.8-flash", "trae-cn/deepseek-v4.1-flash", "workbuddy-vps/cn:deepseek-v4.1-flash"], "translation_workers": {"codex/gpt-6-luna": 50, "antigravity/gemini-3.8-flash": 50, "trae-cn/deepseek-v4.1-flash": 20, "workbuddy-vps/cn:deepseek-v4.1-flash": 30}, "cues": [{"s": 15.09, "e": 16.68, "en": "I met a traveler", "zh": "我遇见一位旅人"}, {"s": 17.89, "e": 19.8, "en": "in an antique land", "zh": "来自古老的土地"}, {"s": 20.29, "e": 22.2, "en": "who said two vast", "zh": "他说有两条巨大"}, {"s": 22.2, "e": 23.96, "en": "and trunkless legs", "zh": "而无躯干的腿"}, {"s": 24.77, "e": 25.88, "en": "stand in the desert.", "zh": "矗立在沙漠中。"}, {"s": 27.41, "e": 32.85, "en": "Near them on the sand, half sunk a shattered visage lies whose frown", "zh": "近旁沙地上，半埋着一副破碎的面容，那紧蹙的眉头"}, {"s": 33.01, "e": 34.53, "en": "and wrinkled lip", "zh": "和皱起的嘴唇"}, {"s": 35.09, "e": 37.25, "en": "and sneer of cold command.", "zh": "和冷酷命令的讥笑。"}, {"s": 38.62, "e": 42.95, "en": "Tell that it sculpture well those passions red, which yet survive", "zh": "告诉那雕刻者，这些情感依然留存"}, {"s": 42.95, "e": 44.14, "en": "stamped", "zh": "铭刻"}, {"s": 44.23, "e": 46.14, "en": "on these lifeless things.", "zh": "在这些无生命的物件上。"}, {"s": 47.82, "e": 49.66, "en": "The hand that mocked them", "zh": "那摹刻它们的手"}, {"s": 50.78, "e": 52.23, "en": "and the heart that fed.", "zh": "和滋养它们的心。"}, {"s": 53.5, "e": 55.26, "en": "And on the pedestal,", "zh": "而在基座上，"}, {"s": 55.42, "e": 56.86, "en": "these words appear.", "zh": "刻着这些字。"}, {"s": 58.06, "e": 59.18, "en": "My name", "zh": "我的名字"}, {"s": 60.22, "e": 62.14, "en": "is Ozymandias,", "zh": "是奥兹曼迪亚斯，"}, {"s": 63.58, "e": 65.1, "en": "king of kings.", "zh": "万王之王。"}, {"s": 66.38, "e": 68.62, "en": "Look on my works, ye mighty,", "zh": "看看我的杰作吧，强者们，"}, {"s": 68.78, "e": 69.98, "en": "and despair.", "zh": "然后绝望吧。"}, {"s": 72.76, "e": 74.59, "en": "Nothing beside remains", "zh": "除此之外，什么也不剩，"}, {"s": 75.48, "e": 78.52, "en": "round the decay of that colossal wreck.", "zh": "只有那座巨大的残骸，四周一片衰败。"}, {"s": 79.64, "e": 81.0, "en": "Boundless and bare,", "zh": "无边无际，荒凉空旷，"}, {"s": 82.1, "e": 84.9, "en": "the lone and level sands stretch", "zh": "孤独平坦的沙地绵延开去，"}, {"s": 85.54, "e": 86.66, "en": "far away.", "zh": "直到远方。"}, {"s": 86.74, "e": 88.74, "en": "And the lord said unto Cain,", "zh": "主对该隐说："}, {"s": 88.9, "e": 91.3, "en": "where is Abel thy winger?", "zh": "你的兄弟亚伯在哪里？"}]}