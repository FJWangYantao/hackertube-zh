{"vid": "D1R-jKKp3NA", "model": "workbuddy-vps/global:deepseek-v4.1-flash", "source": "D1R-jKKp3NA.en.vtt", "cues": [{"s": 6.28, "e": 11.03, "zh": "谢谢"}, {"s": 11.04, "e": 14.03, "zh": "很荣幸今天能和你们在一起"}, {"s": 14.04, "e": 15.39, "zh": "来参加你们的毕业典礼，你们来自"}, {"s": 15.4, "e": 18.38, "zh": "世界上最优秀的大学之一"}, {"s": 19.84, "e": 22.43, "zh": "说实话"}, {"s": 22.44, "e": 25.27, "zh": "我从未大学毕业"}, {"s": 25.28, "e": 28.51, "zh": "呃，这是我离大学毕业"}, {"s": 28.52, "e": 32.91, "zh": "最近的一次"}, {"s": 32.92, "e": 34.91, "zh": "今天我想给你们讲三个故事"}, {"s": 34.92, "e": 38.39, "zh": "我人生中的，就这样，没什么大不了，只是"}, {"s": 38.4, "e": 39.75, "zh": "三个"}, {"s": 39.76, "e": 42.71, "zh": "故事。第一个故事是关于"}, {"s": 42.72, "e": 44.71, "zh": "连接"}, {"s": 44.72, "e": 47.63, "zh": "点。我在 Reed College 读了六个月就退学了"}, {"s": 47.64, "e": 49.39, "zh": "但之后又待了"}, {"s": 49.4, "e": 51.19, "zh": "大约18个月，作为旁听生"}, {"s": 51.2, "e": 53.19, "zh": "之后才真正"}, {"s": 53.2, "e": 56.15, "zh": "退学。那我为什么退学"}, {"s": 56.16, "e": 60.11, "zh": "呢？这要从我出生前说起"}, {"s": 60.12, "e": 62.91, "zh": "我的生母是个年轻未婚的"}, {"s": 62.92, "e": 64.99, "zh": "研究生，她决定把"}, {"s": 65.0, "e": 66.15, "zh": "我送去"}, {"s": 66.16, "e": 68.71, "zh": "收养。她非常坚持，我"}, {"s": 68.72, "e": 70.95, "zh": "应该被大学毕业生收养"}, {"s": 70.96, "e": 73.11, "zh": "所以一切都安排好了，我一出生就"}, {"s": 73.12, "e": 75.71, "zh": "被一位律师和他"}, {"s": 75.72, "e": 78.59, "zh": "妻子收养，只是我出生后他们"}, {"s": 78.6, "e": 80.27, "zh": "最后一刻决定，他们"}, {"s": 80.28, "e": 81.67, "zh": "真的想要一个"}, {"s": 81.68, "e": 84.43, "zh": "女孩。所以我父母当时在等待"}, {"s": 84.44, "e": 86.23, "zh": "名单上，半夜接到电话"}, {"s": 86.24, "e": 89.31, "zh": "问：我们有个意外的"}, {"s": 89.32, "e": 93.23, "zh": "男婴，你们要吗？他们说"}, {"s": 93.24, "e": 94.75, "zh": "当然"}, {"s": 94.76, "e": 97.35, "zh": "要。后来我生母发现"}, {"s": 97.36, "e": 99.51, "zh": "我母亲从未大学毕业"}, {"s": 99.52, "e": 101.55, "zh": "我父亲也从未"}, {"s": 101.56, "e": 104.15, "zh": "高中毕业，她"}, {"s": 104.16, "e": 107.15, "zh": "拒绝签署最终收养"}, {"s": 107.16, "e": 109.63, "zh": "文件。几个月后她才"}, {"s": 109.64, "e": 112.19, "zh": "松口，因为我父母承诺我会"}, {"s": 112.2, "e": 115.67, "zh": "会去上大学。这是我"}, {"s": 115.68, "e": 117.67, "zh": "人生中的"}, {"s": 117.68, "e": 120.43, "zh": "起点。17年后"}, {"s": 120.44, "e": 123.35, "zh": "我确实上了大学，但我天真地选了"}, {"s": 123.36, "e": 125.51, "zh": "一所几乎和"}, {"s": 125.52, "e": 126.27, "zh": "……一样贵的"}, {"s": 126.28, "e": 128.71, "zh": "斯坦福学校。我工薪阶层的"}, {"s": 128.72, "e": 130.55, "zh": "父母的全部积蓄都花在了我的"}, {"s": 130.56, "e": 131.39, "zh": "大学"}, {"s": 131.4, "e": 134.19, "zh": "学费上。6个月后，我看不出"}, {"s": 134.2, "e": 136.59, "zh": "它有什么价值。我不知道我"}, {"s": 136.6, "e": 138.99, "zh": "想拿人生做什么，也不知道"}, {"s": 139.0, "e": 140.59, "zh": "大学要怎么帮我弄明白"}, {"s": 140.6, "e": 143.35, "zh": "这一点。而我却在花光"}, {"s": 143.36, "e": 146.35, "zh": "我父母攒了一辈子的"}, {"s": 146.36, "e": 149.67, "zh": "钱。所以我决定退学，并相信"}, {"s": 149.68, "e": 152.67, "zh": "一切都会好起来。当时"}, {"s": 152.68, "e": 154.51, "zh": "这挺吓人的，但回头"}, {"s": 154.52, "e": 156.47, "zh": "看，那是我做过的最好的决定"}, {"s": 156.48, "e": 157.83, "zh": "之一"}, {"s": 157.84, "e": 161.07, "zh": "。我一退学，就可以"}, {"s": 161.08, "e": 163.03, "zh": "不再上那些必修课——"}, {"s": 163.04, "e": 165.83, "zh": "我不感兴趣的课，并开始旁听"}, {"s": 165.84, "e": 168.55, "zh": "那些看起来有趣得多的"}, {"s": 168.56, "e": 171.43, "zh": "课。这并不全是浪漫的。我"}, {"s": 171.44, "e": 173.19, "zh": "没有宿舍，所以睡在"}, {"s": 173.2, "e": 175.91, "zh": "朋友房间的地板上。我退还"}, {"s": 175.92, "e": 177.99, "zh": "可乐瓶，换5美分押金，用来"}, {"s": 178.0, "e": 180.59, "zh": "买吃的。每周日晚上，我会走七"}, {"s": 180.6, "e": 183.35, "zh": "英里穿过城镇，去"}, {"s": 183.36, "e": 185.15, "zh": "每周去 Hari"}, {"s": 185.16, "e": 188.99, "zh": "Krishna 神庙吃一顿好饭。我很喜欢。很多"}, {"s": 189.0, "e": 191.27, "zh": "我跟随自己的"}, {"s": 191.28, "e": 193.23, "zh": "好奇心和直觉偶然碰到的东西，后来都成了"}, {"s": 193.24, "e": 196.91, "zh": "无价之宝。后来，让我举一个"}, {"s": 196.92, "e": 199.47, "zh": "例子。当时的 Reed College"}, {"s": 199.48, "e": 201.27, "zh": "也许提供了最好的书法"}, {"s": 201.28, "e": 203.43, "zh": "教育，在全国范围内。整个"}, {"s": 203.44, "e": 206.59, "zh": "校园里，每张海报，每个标签"}, {"s": 206.6, "e": 208.71, "zh": "每个抽屉，都被精美地手工"}, {"s": 208.72, "e": 211.47, "zh": "写上书法，因为我退学了"}, {"s": 211.48, "e": 213.39, "zh": "而且不用上常规的"}, {"s": 213.4, "e": 215.91, "zh": "课程，所以我决定去上书法"}, {"s": 215.92, "e": 218.23, "zh": "课，学习怎么做。我学到了"}, {"s": 218.24, "e": 221.07, "zh": "关于衬线字体和无衬线字体"}, {"s": 221.08, "e": 222.63, "zh": "关于调整空间大小"}, {"s": 222.64, "e": 224.59, "zh": "在不同字母组合之间"}, {"s": 224.6, "e": 227.11, "zh": "关于是什么造就了伟大的字体排印"}, {"s": 227.12, "e": 230.59, "zh": "伟大。它优美、有历史感"}, {"s": 230.6, "e": 232.39, "zh": "在艺术上微妙，那种方式是"}, {"s": 232.4, "e": 235.87, "zh": "科学无法捕捉的，而我觉得它"}, {"s": 235.88, "e": 238.55, "zh": "很迷人。这一切甚至没有一点希望"}, {"s": 238.56, "e": 240.31, "zh": "有任何实际应用"}, {"s": 240.32, "e": 241.27, "zh": "在我的"}, {"s": 241.28, "e": 244.15, "zh": "人生中。但10年后，当我们"}, {"s": 244.16, "e": 246.47, "zh": "设计第一台 Macintosh 电脑时"}, {"s": 246.48, "e": 248.95, "zh": "这一切都回来了，我们把它设计"}, {"s": 248.96, "e": 251.43, "zh": "全都融入了 Mac。它是第一台"}, {"s": 251.44, "e": 253.15, "zh": "拥有美丽"}, {"s": 253.16, "e": 255.67, "zh": "字体排印的电脑。如果我从未去旁听"}, {"s": 255.68, "e": 257.99, "zh": "大学里那门课，Mac"}, {"s": 258.0, "e": 259.79, "zh": "就绝不会有多款字体"}, {"s": 259.8, "e": 262.51, "zh": "或比例间距字体。而且既然"}, {"s": 262.52, "e": 264.79, "zh": "Windows 只是复制了 Mac，很可能"}, {"s": 264.8, "e": 266.43, "zh": "没有个人电脑会有"}, {"s": 266.44, "e": 274.63, "zh": "它们"}, {"s": 274.64, "e": 276.71, "zh": "如果我从未退学，我就不会"}, {"s": 276.72, "e": 278.27, "zh": "从未去旁听那门书法"}, {"s": 278.28, "e": 280.27, "zh": "课，个人电脑可能就不会"}, {"s": 280.28, "e": 282.07, "zh": "拥有它们如今那样美妙的字体排印"}, {"s": 282.08, "e": 284.71, "zh": "当然，不可能"}, {"s": 284.72, "e": 286.39, "zh": "在向前看时把点连起来，当我"}, {"s": 286.4, "e": 288.83, "zh": "在大学时。但非常非常"}, {"s": 288.84, "e": 291.95, "zh": "清楚——10年后回望时"}, {"s": 291.96, "e": 294.19, "zh": "再说一次，向前看时你无法把点连起来"}, {"s": 294.2, "e": 296.07, "zh": "向前看，你无法把它们连起来"}, {"s": 296.08, "e": 298.59, "zh": "只能向后看，所以你必须相信"}, {"s": 298.6, "e": 300.15, "zh": "这些点总会以某种方式连起来"}, {"s": 300.16, "e": 302.31, "zh": "在你的未来，你必须相信"}, {"s": 302.32, "e": 305.55, "zh": "某种东西——你的直觉、命运、人生、因果"}, {"s": 305.56, "e": 307.83, "zh": "随便什么。因为相信这些点"}, {"s": 307.84, "e": 310.35, "zh": "会在未来某处连起来，会给你"}, {"s": 310.36, "e": 312.83, "zh": "信心去跟随内心，即便"}, {"s": 312.84, "e": 315.43, "zh": "它带你偏离熟悉的路"}, {"s": 315.44, "e": 322.27, "zh": "而这一切将带来"}, {"s": 322.28, "e": 326.07, "zh": "所有不同。我的第二个故事是关于爱"}, {"s": 326.08, "e": 327.63, "zh": "与"}, {"s": 327.64, "e": 331.03, "zh": "失去。我很幸运，找到了自己热爱做的事"}, {"s": 331.04, "e": 334.11, "zh": "很早就开始了。W和我创办了Apple"}, {"s": 334.12, "e": 336.59, "zh": "在我父母的车库里，当时我20岁。我们"}, {"s": 336.6, "e": 338.83, "zh": "努力工作，10年后Apple从"}, {"s": 338.84, "e": 340.19, "zh": "只有我们两个人"}, {"s": 340.2, "e": 342.95, "zh": "在车库里，发展成一家市值20亿美元、拥有超过"}, {"s": 342.96, "e": 345.75, "zh": "4000名员工的公司。我们刚发布了"}, {"s": 345.76, "e": 347.99, "zh": "最棒的作品Macintosh"}, {"s": 348.0, "e": 349.95, "zh": "就在一年前发布，而我也刚满"}, {"s": 349.96, "e": 352.71, "zh": "30岁。然后我被"}, {"s": 352.72, "e": 354.91, "zh": "炒了。你怎么会被一家"}, {"s": 354.92, "e": 356.15, "zh": "自己"}, {"s": 356.16, "e": 359.71, "zh": "创办的公司炒掉？嗯，随着Apple发展，我们招了"}, {"s": 359.72, "e": 361.67, "zh": "一个我认为非常有才华的人"}, {"s": 361.68, "e": 363.63, "zh": "来和我一起经营公司。在"}, {"s": 363.64, "e": 365.79, "zh": "最初一年左右，事情进展顺利，但"}, {"s": 365.8, "e": 367.35, "zh": "后来我们对未来的愿景开始"}, {"s": 367.36, "e": 369.43, "zh": "出现分歧，最终我们闹翻了。"}, {"s": 369.44, "e": 372.15, "zh": "闹翻后，董事会"}, {"s": 372.16, "e": 375.87, "zh": "站在了他那边。所以30岁时，我出局了。"}, {"s": 375.88, "e": 378.43, "zh": "而且是非常公开地出局。曾经是我"}, {"s": 378.44, "e": 380.95, "zh": "整个成年生活重心的一切都没了，"}, {"s": 380.96, "e": 382.07, "zh": "这真是"}, {"s": 382.08, "e": 383.99, "zh": "毁灭性的。我真的不知道"}, {"s": 384.0, "e": 386.59, "zh": "那几个月该做什么。我觉得自己辜负了……"}, {"s": 386.6, "e": 388.51, "zh": "上一代企业家"}, {"s": 388.52, "e": 390.87, "zh": "结果我在接力棒传递时把它掉了"}, {"s": 390.88, "e": 393.59, "zh": "它传到我手上时，我会见了 David"}, {"s": 393.6, "e": 396.15, "zh": "Packard 和 Bob Noyce，并试图"}, {"s": 396.16, "e": 399.15, "zh": "为搞砸得如此彻底而道歉，我成了"}, {"s": 399.16, "e": 401.07, "zh": "一个非常公开的失败者，我甚至想过"}, {"s": 401.08, "e": 403.31, "zh": "逃离硅谷，但"}, {"s": 403.32, "e": 406.43, "zh": "有件事慢慢开始在我心中浮现，我"}, {"s": 406.44, "e": 408.51, "zh": "仍然热爱我所做的"}, {"s": 408.52, "e": 410.99, "zh": "事。Apple 的变故并没有"}, {"s": 411.0, "e": 414.15, "zh": "改变这一点，我被拒绝了"}, {"s": 414.16, "e": 415.59, "zh": "但我仍然充满"}, {"s": 415.6, "e": 418.35, "zh": "热爱，于是我决定重新"}, {"s": 418.36, "e": 421.11, "zh": "开始。我当时没看出来，但"}, {"s": 421.12, "e": 422.71, "zh": "结果被 Apple 解雇"}, {"s": 422.72, "e": 423.99, "zh": "是我能遇到的最好的"}, {"s": 424.0, "e": 426.59, "zh": "事。身为成功者的沉重"}, {"s": 426.6, "e": 429.11, "zh": "被一种轻盈取代"}, {"s": 429.12, "e": 431.23, "zh": "再次成为初学者，不再那么确定"}, {"s": 431.24, "e": 433.43, "zh": "对一切；它让我自由进入"}, {"s": 433.44, "e": 434.95, "zh": "我一生中最有创造力的时期"}, {"s": 434.96, "e": 437.15, "zh": "之一。接下来的五年里，我"}, {"s": 437.16, "e": 439.39, "zh": "创办了一家叫 NeXT 的公司，另一家"}, {"s": 439.4, "e": 441.47, "zh": "叫 Pixar 的公司，并爱上"}, {"s": 441.48, "e": 442.83, "zh": "一位了不起的女人，她后来成为"}, {"s": 442.84, "e": 445.39, "zh": "我的妻子。Pixar 后来创作了"}, {"s": 445.4, "e": 447.15, "zh": "世界上第一部电脑动画长片"}, {"s": 447.16, "e": 449.67, "zh": "《Toy Story》，现在是最"}, {"s": 449.68, "e": 453.35, "zh": "成功的动画工作室"}, {"s": 453.36, "e": 456.79, "zh": "在世界上。事情出现了惊人的转折"}, {"s": 456.8, "e": 458.95, "zh": "Apple 收购了 NeXT，我回到了"}, {"s": 458.96, "e": 461.23, "zh": "Apple，而我们在"}, {"s": 461.24, "e": 463.23, "zh": "NeXT 开发的技术，正是 Apple 当前"}, {"s": 463.24, "e": 465.83, "zh": "复兴的核心。Loren 和我有一个"}, {"s": 465.84, "e": 467.47, "zh": "美满的家庭"}, {"s": 467.48, "e": 470.03, "zh": "在一起。我很确定，这些"}, {"s": 470.04, "e": 471.15, "zh": "本来会怎样 如果我没被"}, {"s": 471.16, "e": 473.59, "zh": "苹果开除 那药很难吃"}, {"s": 473.6, "e": 475.95, "zh": "但我想病人需要"}, {"s": 475.96, "e": 478.83, "zh": "它 有时候 生活有时会"}, {"s": 478.84, "e": 480.87, "zh": "拿砖头砸你的头"}, {"s": 480.88, "e": 483.55, "zh": "别失去信心 我确信"}, {"s": 483.56, "e": 485.35, "zh": "唯一让我坚持下去的 是我"}, {"s": 485.36, "e": 488.11, "zh": "热爱我所做的事 你必须找到"}, {"s": 488.12, "e": 490.67, "zh": "你热爱的事 这对工作如此"}, {"s": 490.68, "e": 493.27, "zh": "对爱人也是如此 你的工作会"}, {"s": 493.28, "e": 495.19, "zh": "占据你人生很大一部分"}, {"s": 495.2, "e": 497.43, "zh": "唯一真正满足的方式 是"}, {"s": 497.44, "e": 499.67, "zh": "去做你相信是伟大的工作"}, {"s": 499.68, "e": 502.27, "zh": "做出伟大工作的唯一方式 是热爱"}, {"s": 502.28, "e": 505.23, "zh": "你所做的事 如果你还没找到"}, {"s": 505.24, "e": 508.55, "zh": "继续找 别将就 就像"}, {"s": 508.56, "e": 509.95, "zh": "所有内心的事情一样"}, {"s": 509.96, "e": 512.19, "zh": "找到时你就会知道 而且像"}, {"s": 512.2, "e": 514.11, "zh": "任何伟大的关系一样 它只会"}, {"s": 514.12, "e": 516.67, "zh": "随着岁月流逝越来越好"}, {"s": 516.68, "e": 522.71, "zh": "所以继续找 别"}, {"s": 528.76, "e": 532.71, "zh": "将就 我的第三个故事是"}, {"s": 532.72, "e": 535.83, "zh": "关于死亡 我17岁时读到一句话"}, {"s": 535.84, "e": 538.83, "zh": "大意是 如果你把每一天"}, {"s": 538.84, "e": 540.91, "zh": "都当作最后一天 总有一天你"}, {"s": 540.92, "e": 544.31, "zh": "肯定会"}, {"s": 544.32, "e": 547.39, "zh": "是对的 它给我留下深刻印象"}, {"s": 547.4, "e": 550.15, "zh": "从那以后 过去33年里 我"}, {"s": 550.16, "e": 551.59, "zh": "每天早上照镜子"}, {"s": 551.6, "e": 554.11, "zh": "问自己 如果今天是我生命的"}, {"s": 554.12, "e": 556.63, "zh": "最后一天 我会想做"}, {"s": 556.64, "e": 559.39, "zh": "今天要做的事吗 每当"}, {"s": 559.4, "e": 561.31, "zh": "答案连续太多天都是“不”"}, {"s": 561.32, "e": 563.99, "zh": "我就知道我需要改变"}, {"s": 564.0, "e": 566.51, "zh": "一些东西 记住我即将死去"}, {"s": 566.52, "e": 568.71, "zh": "“即将死去”是我"}, {"s": 568.72, "e": 570.39, "zh": "遇到过的最重要工具，帮我做出人生重大"}, {"s": 570.4, "e": 573.19, "zh": "选择，因为几乎"}, {"s": 573.2, "e": 576.39, "zh": "一切——所有外界期望、所有"}, {"s": 576.4, "e": 578.35, "zh": "自尊、所有对尴尬或"}, {"s": 578.36, "e": 580.99, "zh": "失败的恐惧——这些东西都会在"}, {"s": 581.0, "e": 583.51, "zh": "死亡面前消散，只留下真正"}, {"s": 583.52, "e": 586.23, "zh": "重要的东西。记住你"}, {"s": 586.24, "e": 589.07, "zh": "终将死去，是我知道的"}, {"s": 589.08, "e": 590.91, "zh": "避免陷入“自己有所失去”这一陷阱的"}, {"s": 590.92, "e": 594.35, "zh": "最好办法。你本就赤身裸体"}, {"s": 594.36, "e": 597.31, "zh": "没有理由不追随自己的"}, {"s": 597.32, "e": 599.87, "zh": "内心。大约一年前"}, {"s": 599.88, "e": 603.15, "zh": "我被诊断出癌症。我做了次扫描"}, {"s": 603.16, "e": 605.15, "zh": "早上7点半，扫描清楚地"}, {"s": 605.16, "e": 608.19, "zh": "显示我胰腺上有个肿瘤。我甚至"}, {"s": 608.2, "e": 610.83, "zh": "不知道胰腺是什么。"}, {"s": 610.84, "e": 612.75, "zh": "医生告诉我，这几乎"}, {"s": 612.76, "e": 614.51, "zh": "肯定是一种无法"}, {"s": 614.52, "e": 616.51, "zh": "治愈的癌症，并说我预计"}, {"s": 616.52, "e": 620.39, "zh": "活不过3到6个月。我的"}, {"s": 620.4, "e": 622.99, "zh": "医生建议我回家，把我的"}, {"s": 623.0, "e": 626.15, "zh": "事务安排好——这是医生对"}, {"s": 626.16, "e": 629.39, "zh": "“准备死亡”的暗语。意思是试着"}, {"s": 629.4, "e": 630.87, "zh": "告诉你的孩子"}, {"s": 630.88, "e": 632.67, "zh": "你原以为未来10年"}, {"s": 632.68, "e": 635.19, "zh": "能告诉他们的所有事，却要在短短几个"}, {"s": 635.2, "e": 637.51, "zh": "月内说完。意思是确保一切"}, {"s": 637.52, "e": 639.35, "zh": "都安排妥当，尽可能"}, {"s": 639.36, "e": 642.03, "zh": "方便你的家人。这"}, {"s": 642.04, "e": 644.75, "zh": "意味着说出你的"}, {"s": 644.76, "e": 647.43, "zh": "告别。我带着那个诊断过了整整一天"}, {"s": 647.44, "e": 650.79, "zh": "那天晚上，我做了一次活检"}, {"s": 650.8, "e": 652.39, "zh": "他们把内窥镜伸进我的"}, {"s": 652.4, "e": 654.51, "zh": "喉咙，穿过胃，进入我的"}, {"s": 654.52, "e": 657.15, "zh": "肠道，把针扎进我的胰腺"}, {"s": 657.16, "e": 659.75, "zh": "从肿瘤上取了一些细胞"}, {"s": 659.76, "e": 662.83, "zh": "我被麻醉了，但当时在场的妻子"}, {"s": 662.84, "e": 664.63, "zh": "告诉我，他们观察这些细胞时"}, {"s": 664.64, "e": 666.83, "zh": "在显微镜下，医生开始"}, {"s": 666.84, "e": 668.95, "zh": "哭了起来，因为结果发现那是一种"}, {"s": 668.96, "e": 671.31, "zh": "非常罕见的胰腺癌，这种癌"}, {"s": 671.32, "e": 673.71, "zh": "可以通过手术治愈。我做了"}, {"s": 673.72, "e": 684.15, "zh": "手术，谢天谢地，我没事了"}, {"s": 684.16, "e": 686.67, "zh": "现在，这是我离"}, {"s": 686.68, "e": 688.87, "zh": "面对死亡最近的一次，我希望这也是"}, {"s": 688.88, "e": 691.39, "zh": "未来几十年里我离它最近的一次。经历过"}, {"s": 691.4, "e": 693.75, "zh": "这一切后，我现在可以比那时"}, {"s": 693.76, "e": 695.55, "zh": "更确定地对你们说"}, {"s": 695.56, "e": 697.27, "zh": "死亡曾是一个有用但纯粹"}, {"s": 697.28, "e": 699.03, "zh": "理性的"}, {"s": 699.04, "e": 703.03, "zh": "概念。没有人想死，即使是"}, {"s": 703.04, "e": 704.79, "zh": "想上天堂的人，也不想"}, {"s": 704.8, "e": 708.39, "zh": "为了去那里而死。然而死亡是"}, {"s": 708.4, "e": 711.27, "zh": "我们共同的归宿，从来没有人"}, {"s": 711.28, "e": 714.67, "zh": "逃得过它，而且本该如此"}, {"s": 714.68, "e": 717.07, "zh": "因为死亡很可能是生命"}, {"s": 717.08, "e": 719.91, "zh": "最棒的单项发明。它是生命的"}, {"s": 719.92, "e": 722.11, "zh": "变革推动者，它清除旧的"}, {"s": 722.12, "e": 725.35, "zh": "为新的让路。现在，新的"}, {"s": 725.36, "e": 728.79, "zh": "就是你们。但不久的将来某天"}, {"s": 728.8, "e": 730.95, "zh": "你们会逐渐变成旧的，并被"}, {"s": 730.96, "e": 734.63, "zh": "清除掉。抱歉说得这么戏剧化，但"}, {"s": 734.64, "e": 735.83, "zh": "这相当"}, {"s": 735.84, "e": 739.39, "zh": "真实。你们的时间有限，所以不要浪费"}, {"s": 739.4, "e": 742.63, "zh": "它去过别人的生活。不要被"}, {"s": 742.64, "e": 744.75, "zh": "教条困住，那是在按照"}, {"s": 744.76, "e": 747.35, "zh": "别人思考的结果生活。不要"}, {"s": 747.36, "e": 749.27, "zh": "让他人观点的噪音"}, {"s": 749.28, "e": 751.71, "zh": "淹没你内心的声音。而"}, {"s": 751.72, "e": 753.63, "zh": "最重要的是，要有勇气去"}, {"s": 753.64, "e": 756.03, "zh": "追随你的内心和直觉。它们"}, {"s": 756.04, "e": 758.63, "zh": "不知怎么，已经知道自己真正想要什么"}, {"s": 758.64, "e": 765.87, "zh": "去成为什么，其他一切"}, {"s": 772.84, "e": 775.95, "zh": "都是次要的。我年轻时，有一份"}, {"s": 775.96, "e": 778.07, "zh": "了不起的出版物，叫 The Whole"}, {"s": 778.08, "e": 780.27, "zh": "Earth Catalog，它是我那一代人的"}, {"s": 780.28, "e": 783.15, "zh": "圣经之一。它由"}, {"s": 783.16, "e": 785.51, "zh": "一个叫 Stuart Brand 的人创办，就在"}, {"s": 785.52, "e": 787.91, "zh": "这附近的 Meno Park。他把它"}, {"s": 787.92, "e": 790.67, "zh": "用诗意的方式变成现实。那是"}, {"s": 790.68, "e": 792.47, "zh": "60年代末，个人"}, {"s": 792.48, "e": 794.87, "zh": "电脑和桌面出版还没出现，所以它"}, {"s": 794.88, "e": 797.07, "zh": "全靠打字机、剪刀"}, {"s": 797.08, "e": 799.63, "zh": "和 Polaroid 相机做出来。它有点像"}, {"s": 799.64, "e": 802.43, "zh": "纸质版 Google，比 Google 早35年"}, {"s": 802.44, "e": 805.71, "zh": "出现。它充满理想主义"}, {"s": 805.72, "e": 807.95, "zh": "满是巧妙的工具和伟大的"}, {"s": 807.96, "e": 809.47, "zh": "想法。"}, {"s": 809.48, "e": 811.19, "zh": "Stuart 和团队出了好几期"}, {"s": 811.2, "e": 813.55, "zh": "The Whole Earth Catalog，而当"}, {"s": 813.56, "e": 815.91, "zh": "它完成使命后，他们出了"}, {"s": 815.92, "e": 819.63, "zh": "最后一期。那是1970年代中期"}, {"s": 819.64, "e": 821.71, "zh": "而我和你们"}, {"s": 821.72, "e": 824.31, "zh": "差不多大。最后一期的封底"}, {"s": 824.32, "e": 826.67, "zh": "是一张清晨"}, {"s": 826.68, "e": 829.15, "zh": "乡间公路的照片，那种你可能会"}, {"s": 829.16, "e": 831.23, "zh": "搭便车经过的路，如果你"}, {"s": 831.24, "e": 832.11, "zh": "够"}, {"s": 832.12, "e": 835.11, "zh": "爱冒险。照片下面写着："}, {"s": 835.12, "e": 838.47, "zh": "保持饥饿，保持愚蠢。这是他们"}, {"s": 838.48, "e": 841.75, "zh": "告别的话。他们签下：保持"}, {"s": 841.76, "e": 845.19, "zh": "饥饿，保持愚蠢。我一直"}, {"s": 845.2, "e": 846.79, "zh": "希望自己"}, {"s": 846.8, "e": 850.11, "zh": "也能如此。现在你们毕业，开始"}, {"s": 850.12, "e": 854.39, "zh": "新的人生，我也希望你们如此：保持饥饿。"}, {"s": 854.4, "e": 859.88, "zh": "保持愚蠢。非常感谢大家。"}]}