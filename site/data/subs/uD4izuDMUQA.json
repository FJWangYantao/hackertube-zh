{"vid": "uD4izuDMUQA", "model": "workbuddy-vps/cn:fast-model", "source": "uD4izuDMUQA.en.vtt", "cues": [{"s": 0.0, "e": 0.77, "zh": "技术支持："}, {"s": 0.77, "e": 2.64, "zh": "技术支持：Protocol Labs"}, {"s": 2.64, "e": 2.94, "zh": "Protocol Labs"}, {"s": 2.94, "e": 4.62, "zh": "Protocol Labs 我们的未来会怎样？"}, {"s": 6.15, "e": 10.34, "zh": "万物皆有奇妙之处，即使是黑暗与寂静……"}, {"s": 10.34, "e": 13.39, "zh": "万物皆有奇妙之处，即使是黑暗与寂静……——海伦·凯勒"}, {"s": 14.61, "e": 18.18, "zh": "未来是什么样子？"}, {"s": 18.69, "e": 22.13, "zh": "宇宙将如何终结？"}, {"s": 22.68, "e": 25.58, "zh": "我们也许永远无法真正确定。"}, {"s": 26.43, "e": 30.58, "zh": "但科学已经开始描绘出一幅令人惊叹的图景，展现未来可能如何展开。"}, {"s": 31.56, "e": 34.51, "zh": "让我们踏上一段通往时间尽头的旅程。"}, {"s": 34.81, "e": 38.62, "zh": "我们将以指数方式穿越时间，每5秒速度翻倍。"}, {"s": 38.9, "e": 44.63, "zh": "随着我们探寻更多线索，对未来的设想必然会不断演变。但有一点很清楚："}, {"s": 44.81, "e": 46.54, "zh": "宇宙才刚刚开始。"}, {"s": 46.54, "e": 47.54, "zh": "2019 [人类世]"}, {"s": 47.54, "e": 48.54, "zh": "2020 [人类世]"}, {"s": 48.54, "e": 48.79, "zh": "2021 [人类世]"}, {"s": 48.79, "e": 49.17, "zh": "2021 全新世已经结束。[人类世]"}, {"s": 49.17, "e": 49.56, "zh": "2021 全新世已经结束。[人类世]"}, {"s": 49.56, "e": 50.58, "zh": "2022 全新世已经结束。[人类世]"}, {"s": 50.58, "e": 51.32, "zh": "2023 全新世已经结束。[人类世]"}, {"s": 51.32, "e": 51.57, "zh": "2023 [人类世]"}, {"s": 51.97, "e": 52.23, "zh": "我们现在所做的，"}, {"s": 52.23, "e": 52.48, "zh": "我们现在所做的，"}, {"s": 52.48, "e": 52.97, "zh": "我们现在所做的，"}, {"s": 52.97, "e": 53.34, "zh": "我们现在所做的，"}, {"s": 53.72, "e": 55.24, "zh": "以及在接下来几年所做的，"}, {"s": 56.24, "e": 58.24, "zh": "将深刻影响"}, {"s": 58.24, "e": 61.52, "zh": "未来几千年。"}, {"s": 63.93, "e": 66.25, "zh": "现代人类"}, {"s": 66.25, "e": 69.74, "zh": "迄今所知唯一的环境，正在改变。"}, {"s": 70.08, "e": 71.35, "zh": "而且变化飞快。"}, {"s": 73.16, "e": 75.78, "zh": "这颗星球上没有什么是一成不变的。"}, {"s": 75.78, "e": 77.7, "zh": "一切都在变。"}, {"s": 77.94, "e": 78.67, "zh": "地球正进入其中一次跃变"}, {"s": 78.67, "e": 80.23, "zh": "地球正进入其中一次跃变"}, {"s": 80.23, "e": 81.25, "zh": "而你无法预知跃变的"}, {"s": 81.25, "e": 83.24, "zh": "另一头会是什么。"}, {"s": 84.31, "e": 85.75, "zh": "地球始终在跃变。[地球磁场翻转]"}, {"s": 92.78, "e": 94.72, "zh": "这颗星球上的事物在移动 [海平面急剧上升]"}, {"s": 95.22, "e": 96.68, "zh": "万物并非静止！"}, {"s": 97.24, "e": 98.64, "zh": "一切都在转动。[30米小行星撞击]"}, {"s": 178.79, "e": 179.75, "zh": "当它开始耗尽燃料，[太阳亮度增加]"}, {"s": 179.75, "e": 181.04, "zh": "当它开始耗尽燃料，[光合作用停止]"}, {"s": 181.04, "e": 182.74, "zh": "太阳不会就这样渐渐消失殆尽。[光合作用停止]"}, {"s": 182.74, "e": 183.96, "zh": "太阳不会就这样渐渐消失殆尽。[所有植物死亡]"}, {"s": 185.88, "e": 187.68, "zh": "它的核心将会坍缩，[海洋蒸发]"}, {"s": 187.93, "e": 190.01, "zh": "由此产生的额外热量 [海洋蒸发]"}, {"s": 190.01, "e": 191.91, "zh": "将使其外层膨胀。[海洋蒸发]"}, {"s": 191.91, "e": 192.62, "zh": "将使其外层膨胀。[所有生命死亡]"}, {"s": 202.18, "e": 204.6, "zh": "太阳此时已经死亡。[太阳变成白矮星]"}, {"s": 204.6, "e": 206.77, "zh": "它的残骸在深空的严寒中"}, {"s": 206.77, "e": 210.24, "zh": "缓慢冷却。"}, {"s": 219.95, "e": 223.77, "zh": "太阳的命运与所有恒星相同。"}, {"s": 224.38, "e": 227.71, "zh": "总有一天，它们终将全部死去，"}, {"s": 227.71, "e": 229.65, "zh": "宇宙将陷入"}, {"s": 229.65, "e": 232.41, "zh": "永恒的黑夜。"}, {"s": 234.13, "e": 237.51, "zh": "所有恒星最终都会耗尽燃料。[恒星开始相继死亡]"}, {"s": 238.3, "e": 239.94, "zh": "宇宙温度下降。[恒星开始相继死亡]"}, {"s": 240.94, "e": 242.5, "zh": "恒星一颗接一颗，"}, {"s": 242.5, "e": 244.26, "zh": "在夜空中，"}, {"s": 244.26, "e": 246.23, "zh": "熄灭。"}, {"s": 247.98, "e": 250.23, "zh": "不会再有新的恒星"}, {"s": 250.23, "e": 251.67, "zh": "诞生。"}, {"s": 253.0, "e": 254.78, "zh": "于是宇宙将终结"}, {"s": 254.95, "e": 256.24, "zh": "不是轰然巨响，"}, {"s": 256.24, "e": 258.49, "zh": "而是低声呜咽。"}, {"s": 261.36, "e": 263.13, "zh": "不是在烈火中，[最后的红矮星死亡]"}, {"s": 263.38, "e": 266.24, "zh": "而是在冰寒中。[最后的红矮星死亡]"}, {"s": 269.69, "e": 277.59, "zh": "[退化时代]“随着最后一颗太阳的死亡，星光时代走向终结。”"}, {"s": 279.8, "e": 280.88, "zh": "[退化时代]“宇宙变成一片宇宙坟场，散落着死星的残骸。”"}, {"s": 280.88, "e": 287.57, "zh": "“宇宙变成一片宇宙坟场，散落着死星的残骸。”"}, {"s": 290.26, "e": 296.65, "zh": "我们的太阳会变成一颗白矮星——一具炽热、致密、萎缩的恒星遗骸。"}, {"s": 301.5, "e": 303.59, "zh": "再也没有燃料可以燃烧，"}, {"s": 303.67, "e": 305.74, "zh": "白矮星微弱的辉光"}, {"s": 305.85, "e": 308.49, "zh": "来自最后残余的热量"}, {"s": 308.49, "e": 310.47, "zh": "来自它熄灭的熔炉。"}, {"s": 315.51, "e": 318.27, "zh": "从地球现在所在的位置看它，"}, {"s": 318.27, "e": 320.93, "zh": "它产生的光量"}, {"s": 320.93, "e": 322.6, "zh": "只相当于满月"}, {"s": 322.64, "e": 325.57, "zh": "在晴朗夜晚的亮度。"}, {"s": 328.96, "e": 331.5, "zh": "白矮星微弱的辉光"}, {"s": 331.5, "e": 334.23, "zh": "将是唯一的照明"}, {"s": 334.23, "e": 336.5, "zh": "在黑暗空旷的虚空中"}, {"s": 336.93, "e": 339.49, "zh": "散落着死去的恒星"}, {"s": 339.49, "e": 341.89, "zh": "和黑洞。"}, {"s": 350.49, "e": 352.93, "zh": "某种程度上，这像个幽灵宇宙"}, {"s": 352.93, "e": 354.04, "zh": "是那些尸体，"}, {"s": 354.04, "e": 355.16, "zh": "僵尸恒星，"}, {"s": 355.23, "e": 356.69, "zh": "将带我们走向未来。"}, {"s": 366.74, "e": 373.15, "zh": "\"随着时间推移，引力将死去的恒星和行星逐出它们的星系，把它们送入冰冷的虚空。\""}, {"s": 378.11, "e": 382.95, "zh": "\"偶然间，一些褐矮星相撞，形成了意外的新恒星。\""}, {"s": 387.62, "e": 391.56, "zh": "中子星碰撞，以超亮超新星的光芒刺破黑暗。"}, {"s": 391.56, "e": 392.88, "zh": "[中子星碰撞] 中子星碰撞，以超亮超新星的光芒刺破黑暗。"}, {"s": 411.21, "e": 418.01, "zh": "任何幸存的生命形式，或许能在老去的白矮星周围找到庇护所。"}, {"s": 425.75, "e": 431.62, "zh": "但终有一天，连白矮星也会黯淡消亡。"}, {"s": 433.24, "e": 437.24, "zh": "黑矮星将是这些最后恒星最终的归宿 [恒星变成黑矮星]"}, {"s": 437.24, "e": 439.75, "zh": "白矮星变得如此寒冷，[恒星变成黑矮星]"}, {"s": 439.75, "e": 443.49, "zh": "以至于几乎不再散发任何热量或光芒。"}, {"s": 447.51, "e": 449.23, "zh": "黑矮星是黑暗的、"}, {"s": 449.23, "e": 450.25, "zh": "致密的、"}, {"s": 450.25, "e": 454.09, "zh": "正在衰变的简并态物质球体。"}, {"s": 454.27, "e": 457.22, "zh": "不过是恒星的余烬罢了，"}, {"s": 458.24, "e": 461.98, "zh": "其组成原子被极度挤压，"}, {"s": 461.98, "e": 464.52, "zh": "以至于黑矮星的密度"}, {"s": 464.52, "e": 468.26, "zh": "比我们的太阳高出一百万倍。"}, {"s": 474.5, "e": 477.18, "zh": "恒星要经历如此漫长的时间才能到达这一步，"}, {"s": 477.45, "e": 479.12, "zh": "我们相信目前宇宙中"}, {"s": 479.12, "e": 482.7, "zh": "还不存在任何黑矮星。"}, {"s": 490.88, "e": 497.0, "zh": "任何未能逃出自己星系的物质都会被吸入星系中心的超大质量黑洞。"}, {"s": 506.34, "e": 511.5, "zh": "[黑洞吞噬游离物质] “长期休眠的黑洞会突然爆发，绽放出耀眼光芒。”"}, {"s": 531.68, "e": 539.5, "zh": "[退化时代] “黑洞的旋转能量成为未来任何奇异文明最后可靠的能源。”"}, {"s": 545.26, "e": 547.21, "zh": "我们的生命节奏基于"}, {"s": 547.21, "e": 549.25, "zh": "我们当下可获得的能量。"}, {"s": 550.49, "e": 552.25, "zh": "你可以想象存在"}, {"s": 552.25, "e": 553.74, "zh": "有意识的系统，"}, {"s": 553.74, "e": 555.84, "zh": "它们的节奏截然不同，因此"}, {"s": 555.95, "e": 557.6, "zh": "至少能延伸到"}, {"s": 557.6, "e": 559.92, "zh": "远超你想象的地方。"}, {"s": 561.51, "e": 563.69, "zh": "你可以有这样的生命系统：如果"}, {"s": 563.69, "e": 566.42, "zh": "它每10万亿年才思考一次，"}, {"s": 566.42, "e": 567.92, "zh": "那对它来说也很正常。"}, {"s": 570.76, "e": 571.51, "zh": "即便"}, {"s": 571.51, "e": 574.56, "zh": "我们的生命消亡了，你也可以想象"}, {"s": 574.85, "e": 577.74, "zh": "在未来某个任意遥远的时刻，"}, {"s": 577.74, "e": 581.15, "zh": "出现一次涨落，让智能生命"}, {"s": 581.15, "e": 583.23, "zh": "得以再次存在一小段时间。"}, {"s": 584.49, "e": 587.5, "zh": "所以智能可能会在时间上呈现为孤岛。"}, {"s": 596.35, "e": 604.16, "zh": "“随着宇宙膨胀加速，物质开始以超过光速的速度彼此远离。”【时空膨胀】"}, {"s": 605.5, "e": 607.23, "zh": "“到那时，遥远的星系和恒星退行得太快，它们的光已经无法被探测到。”【时空膨胀】"}, {"s": 607.23, "e": 613.16, "zh": "“到那时，遥远的星系和恒星退行得太快，它们的光已经无法被探测到。”"}, {"s": 614.51, "e": 621.86, "zh": "“宇宙的秘密将被永远封存。”"}, {"s": 625.27, "e": 628.25, "zh": "“当前理论预测，原子本身将开始衰变，摧毁宇宙中所有剩余的物质。”"}, {"s": 628.25, "e": 633.08, "zh": "【质子衰变】“当前理论预测，原子本身将开始衰变，摧毁宇宙中所有剩余的物质。”"}, {"s": 634.54, "e": 637.27, "zh": "质子是构成原子物质的基本单元之一"}, {"s": 637.27, "e": 639.76, "zh": "构成了我们自身"}, {"s": 639.78, "e": 642.16, "zh": "却可能自发衰变"}, {"s": 644.26, "e": 647.24, "zh": "任何逃过黑洞引力的物质"}, {"s": 647.27, "e": 651.19, "zh": "最终都会随着质子衰变而消亡"}, {"s": 658.42, "e": 666.79, "zh": "“质子衰变尚未得到证实——因此，未来的这一篇章可能会因新发现而截然不同。”"}, {"s": 677.99, "e": 680.5, "zh": "黑矮星内部的物质"}, {"s": 680.53, "e": 682.77, "zh": "是宇宙中最后的物质"}, {"s": 683.25, "e": 685.78, "zh": "最终会蒸发殆尽"}, {"s": 685.82, "e": 689.48, "zh": "作为辐射被带入虚空"}, {"s": 689.51, "e": 694.61, "zh": "不留下任何东西"}, {"s": 702.23, "e": 704.55, "zh": "随着黑矮星消失，[黑洞时代]"}, {"s": 704.55, "e": 708.24, "zh": "将不会剩下任何一个原子。[黑洞时代]"}, {"s": 711.73, "e": 715.22, "zh": "我们曾经丰富的宇宙所留下的"}, {"s": 715.27, "e": 718.62, "zh": "只有光粒子和黑洞"}, {"s": 726.86, "e": 729.75, "zh": "黑洞时代开始了。"}, {"s": 731.87, "e": 736.99, "zh": "没有行星，没有恒星，也没有可供生命依附的残留恒星遗迹。"}, {"s": 740.53, "e": 746.24, "zh": "然而即便到了那时，时间才刚刚开始滴答作响。"}, {"s": 748.61, "e": 751.75, "zh": "以人类寿命的尺度来看，宇宙才刚刚脱离母腹。"}, {"s": 755.97, "e": 762.49, "zh": "寒冷、黑暗、空无一物——宇宙将这样度过它生命的大部分时光。"}, {"s": 767.11, "e": 776.35, "zh": "我们的宇宙只给生命短暂的一瞬去闪耀——那是时间长河中的一处避风港，既不受炽烈诞生的炙烤，也免于冰冷死亡的侵袭。"}, {"s": 776.75, "e": 779.99, "zh": "时间之箭创造了一扇明亮的窗口"}, {"s": 779.99, "e": 782.26, "zh": "在宇宙的青春期"}, {"s": 782.26, "e": 784.47, "zh": "生命在此期间才得以存在。"}, {"s": 788.01, "e": 791.24, "zh": "但这扇窗不会敞开太久。"}, {"s": 795.0, "e": 798.76, "zh": "以宇宙寿命的比例来衡量，"}, {"s": 798.76, "e": 800.76, "zh": "从宇宙的起点算起"}, {"s": 800.76, "e": 803.48, "zh": "直到最后一个黑洞蒸发殆尽，"}, {"s": 803.76, "e": 804.75, "zh": "生命，"}, {"s": 804.75, "e": 805.73, "zh": "我们所知的生命，"}, {"s": 805.73, "e": 807.35, "zh": "我们所知的生命，只可能存在"}, {"s": 807.35, "e": 807.75, "zh": "一（10^(0)）"}, {"s": 807.75, "e": 808.76, "zh": "千分之一（10^(-3)）"}, {"s": 808.76, "e": 809.23, "zh": "千分之一（10^(-3)）"}, {"s": 809.23, "e": 809.72, "zh": "十亿分之一千（10^(-12)）"}, {"s": 809.72, "e": 810.19, "zh": "十亿个十亿分之一千（10^(-21)）"}, {"s": 810.19, "e": 810.75, "zh": "十亿个十亿个十亿分之一千（10^(-30)）"}, {"s": 810.75, "e": 811.26, "zh": "十亿个十亿个十亿、十亿分之一千（10^(-39)）"}, {"s": 811.26, "e": 811.76, "zh": "十亿个十亿个十亿、十亿个十亿分之一千（10^(-48)）"}, {"s": 811.76, "e": 812.32, "zh": "十亿个十亿个十亿、十亿个十亿个十亿分之一千（10^(-57)）"}, {"s": 812.32, "e": 812.75, "zh": "十亿个十亿个十亿、十亿个十亿个十亿个十亿分之一千（10^(-66)）"}, {"s": 812.75, "e": 813.52, "zh": "十亿亿亿亿分之一，十亿亿亿亿亿亿分之一（10^(-75)）"}, {"s": 813.52, "e": 814.63, "zh": "十亿亿亿亿分之一，十亿亿亿亿亿亿亿亿分之一（10^(-84)）"}, {"s": 814.63, "e": 816.48, "zh": "十亿亿亿亿分之一，十亿亿亿亿亿亿亿亿分之一，的百分之一。（10^(-84)%）"}, {"s": 824.77, "e": 825.77, "zh": "黑洞成为"}, {"s": 825.77, "e": 828.26, "zh": "宇宙的基本构成单元。"}, {"s": 832.52, "e": 833.99, "zh": "一个星系基本上会是"}, {"s": 833.99, "e": 835.78, "zh": "中心有一个超大质量黑洞，"}, {"s": 835.78, "e": 837.79, "zh": "周围有较小的黑洞环绕运行。"}, {"s": 841.74, "e": 846.76, "zh": "充满黑洞的僵尸星系会继续演化。"}, {"s": 850.26, "e": 851.78, "zh": "它们会互相吞噬，变得更大，"}, {"s": 851.78, "e": 852.76, "zh": "也许它们会落入"}, {"s": 852.76, "e": 854.96, "zh": "超大质量黑洞，让它变得更大。"}, {"s": 855.01, "e": 857.75, "zh": "宇宙仍将是一个令人兴奋、充满活力的地方。"}, {"s": 857.75, "e": 860.25, "zh": "只是我们现在讨论的时间尺度"}, {"s": 860.25, "e": 862.02, "zh": "已经变成了数万亿年，"}, {"s": 862.02, "e": 864.5, "zh": "而不是几千年或几百万年。"}, {"s": 869.89, "e": 875.95, "zh": "[黑洞合并] “在这个遥远的时代，黑洞合并成为主要事件。”"}, {"s": 878.6, "e": 885.28, "zh": "“有些会增长到极其巨大的尺寸，可能达到太阳质量数万亿倍。”"}, {"s": 889.39, "e": 895.48, "zh": "“当它们合并时，会发出强大的引力波，在整个宇宙中回荡。”"}, {"s": 896.24, "e": 901.5, "zh": "黑洞能像鼓槌敲鼓一样敲击时空。"}, {"s": 908.76, "e": 911.5, "zh": "并发出非常有特色的歌声，"}, {"s": 917.74, "e": 921.04, "zh": "想象两个黑洞共同度过了漫长的一生"}, {"s": 922.01, "e": 924.5, "zh": "在生命尽头，它们互相绕转，"}, {"s": 924.5, "e": 928.27, "zh": "在几分之一秒内跨越数千公里。"}, {"s": 932.23, "e": 933.2, "zh": "在这个过程中，"}, {"s": 933.2, "e": 936.52, "zh": "它们在身后留下空间的回响"}, {"s": 936.52, "e": 938.76, "zh": "一道真实的时空波。"}, {"s": 953.26, "e": 956.5, "zh": "时空在向外扩散时会被挤压和拉伸"}, {"s": 956.5, "e": 959.01, "zh": "从这些猛烈撞击宇宙的黑洞中"}, {"s": 962.99, "e": 964.92, "zh": "这就是引力波"}, {"s": 964.92, "e": 967.52, "zh": "它们 literally 就是时空回响的声音"}, {"s": 967.52, "e": 969.48, "zh": "它们会从这些黑洞向外传播"}, {"s": 969.48, "e": 973.76, "zh": "以光速传播，同时逐渐衰减并合并成一个"}, {"s": 973.76, "e": 976.36, "zh": "旋转的、寂静的黑洞"}, {"s": 980.99, "e": 982.98, "zh": "如果你站得足够近"}, {"s": 983.01, "e": 984.95, "zh": "你的耳朵会共振"}, {"s": 985.16, "e": 987.5, "zh": "随着时空的挤压和拉伸"}, {"s": 987.53, "e": 989.74, "zh": "你会真切地听到那个声音"}, {"s": 998.99, "e": 1001.22, "zh": "想象一个较轻的黑洞"}, {"s": 1001.22, "e": 1003.11, "zh": "落入一个非常重的黑洞"}, {"s": 1003.22, "e": 1004.95, "zh": "你现在听到的声音"}, {"s": 1004.95, "e": 1006.98, "zh": "就是一个轻黑洞每次靠近时"}, {"s": 1006.98, "e": 1009.58, "zh": "撞击时空发出的"}, {"s": 1018.01, "e": 1021.5, "zh": "随着它落入，速度越来越快，声音也越来越响"}, {"s": 1042.74, "e": 1045.74, "zh": "科学家曾以为黑洞是永生的"}, {"s": 1045.77, "e": 1048.22, "zh": "但即便是它们，也终有一天会消亡"}, {"s": 1049.27, "e": 1052.99, "zh": "现在我们说的是难以想象的时间尺度"}, {"s": 1052.99, "e": 1055.23, "zh": "未来数千万亿年。"}, {"s": 1055.98, "e": 1057.0, "zh": "在那个时间尺度上，"}, {"s": 1057.0, "e": 1060.24, "zh": "连黑洞也开始蒸发。"}, {"s": 1072.01, "e": 1072.26, "zh": "[霍金辐射] 根据量子力学，"}, {"s": 1072.26, "e": 1073.39, "zh": "根据量子力学，"}, {"s": 1073.39, "e": 1074.49, "zh": "[霍金辐射] 根据量子力学，"}, {"s": 1074.49, "e": 1074.98, "zh": "太空充满了虚拟粒子"}, {"s": 1074.98, "e": 1076.75, "zh": "[霍金辐射] 太空充满了虚拟粒子"}, {"s": 1076.75, "e": 1077.5, "zh": "太空充满了虚拟粒子"}, {"s": 1077.5, "e": 1079.75, "zh": "[霍金辐射] 以及不断成对出现的反粒子，"}, {"s": 1079.75, "e": 1081.24, "zh": "以及不断成对出现的反粒子，"}, {"s": 1081.24, "e": 1082.72, "zh": "[霍金辐射] 以及不断成对出现的反粒子，"}, {"s": 1082.72, "e": 1083.5, "zh": "[霍金辐射] 分离，再次结合，"}, {"s": 1083.5, "e": 1084.74, "zh": "分离，再次结合，"}, {"s": 1084.74, "e": 1086.16, "zh": "[霍金辐射] 分离，再次结合，"}, {"s": 1086.16, "e": 1086.74, "zh": "[霍金辐射] 并相互湮灭。"}, {"s": 1086.74, "e": 1087.28, "zh": "并相互湮灭。"}, {"s": 1087.28, "e": 1088.28, "zh": "[霍金辐射] 并相互湮灭。"}, {"s": 1092.99, "e": 1095.51, "zh": "[霍金辐射] 在黑洞附近，"}, {"s": 1095.77, "e": 1096.64, "zh": "一对中的一个"}, {"s": 1096.64, "e": 1097.44, "zh": "[霍金辐射] 一对中的一个"}, {"s": 1097.44, "e": 1098.75, "zh": "[霍金辐射] 虚粒子可能落入黑洞，"}, {"s": 1098.75, "e": 1099.76, "zh": "虚粒子可能落入黑洞，"}, {"s": 1099.76, "e": 1100.25, "zh": "[霍金辐射] 虚粒子可能落入黑洞，"}, {"s": 1100.25, "e": 1100.5, "zh": "虚粒子可能落入黑洞，"}, {"s": 1100.98, "e": 1102.38, "zh": "留下另一个"}, {"s": 1102.38, "e": 1104.01, "zh": "没有可以与之湮灭的伙伴。"}, {"s": 1104.01, "e": 1104.5, "zh": "[霍金辐射] 没有可以与之湮灭的伙伴。"}, {"s": 1104.5, "e": 1105.5, "zh": "没有可以与之湮灭的伙伴。"}, {"s": 1107.26, "e": 1107.74, "zh": "[霍金辐射] 被遗弃的粒子看起来像是辐射"}, {"s": 1107.74, "e": 1109.99, "zh": "被遗弃的粒子看起来像是辐射"}, {"s": 1109.99, "e": 1110.5, "zh": "[霍金辐射] 被遗弃的粒子看起来像是辐射"}, {"s": 1110.5, "e": 1111.27, "zh": "被遗弃的粒子看起来像是辐射"}, {"s": 1111.27, "e": 1112.97, "zh": "由黑洞发射出来的。"}, {"s": 1112.97, "e": 1113.51, "zh": "[霍金辐射]由黑洞发射。"}, {"s": 1116.5, "e": 1117.49, "zh": "所以，黑洞并非永恒。"}, {"s": 1117.49, "e": 1121.03, "zh": "所以，黑洞并非永恒。[黑洞蒸发]"}, {"s": 1123.23, "e": 1127.23, "zh": "它们以越来越快的速度蒸发，"}, {"s": 1127.23, "e": 1131.52, "zh": "直到在一场巨大的爆炸中消失。"}, {"s": 1137.5, "e": 1141.75, "zh": "量子力学让粒子和辐射[黑洞开始消亡]"}, {"s": 1141.75, "e": 1144.76, "zh": "得以逃离终极牢笼——"}, {"s": 1144.92, "e": 1146.5, "zh": "黑洞。"}, {"s": 1146.87, "e": 1153.09, "zh": "“黑洞开始蒸发，抹去宇宙中最后的大尺度结构。”"}, {"s": 1154.75, "e": 1158.75, "zh": "“当它们消亡时，它们一个接一个地点亮黑暗。”"}, {"s": 1200.06, "e": 1200.31, "zh": "“随着黑洞慢慢消亡，宇宙继续膨胀，由一种我们尚未理解的神秘力量驱动。”"}, {"s": 1200.31, "e": 1208.77, "zh": "[暗能量使宇宙膨胀]“随着黑洞慢慢消亡，宇宙继续膨胀，由一种我们尚未理解的神秘力量驱动。”"}, {"s": 1211.9, "e": 1217.73, "zh": "这是人类知识的前沿——一个充满探索与发现机遇的前沿。"}, {"s": 1217.73, "e": 1220.04, "zh": "哲学家和诗人曾提出这样一个问题："}, {"s": 1220.04, "e": 1222.25, "zh": "“世界将以火终结，还是以冰终结？”"}, {"s": 1223.49, "e": 1226.25, "zh": "我们现在可以给出答案。"}, {"s": 1228.23, "e": 1230.73, "zh": "最新证据表明，宇宙"}, {"s": 1230.73, "e": 1231.75, "zh": "并没有在减速，"}, {"s": 1231.75, "e": 1234.27, "zh": "而是在失控地加速膨胀。"}, {"s": 1235.24, "e": 1238.02, "zh": "我们认为，宇宙将在冰中消亡，"}, {"s": 1239.0, "e": 1241.52, "zh": "那是在万亿又万亿年之后。"}, {"s": 1245.27, "e": 1247.75, "zh": "空无一物的空间本身也具有能量。"}, {"s": 1247.75, "e": 1250.01, "zh": "在每一立方厘米的空间里，"}, {"s": 1250.01, "e": 1251.5, "zh": "无论其中是否有物质，"}, {"s": 1251.5, "e": 1252.76, "zh": "无论其中是否有粒子、"}, {"s": 1252.76, "e": 1254.26, "zh": "物质、辐射，还是别的什么……"}, {"s": 1254.26, "e": 1257.26, "zh": "空间本身就依然存在能量。"}, {"s": 1260.48, "e": 1262.42, "zh": "根据爱因斯坦的理论，这种能量"}, {"s": 1262.42, "e": 1264.72, "zh": "会对宇宙施加一种推力。"}, {"s": 1267.01, "e": 1269.96, "zh": "究竟是什么奇怪的东西在加速宇宙膨胀？"}, {"s": 1270.5, "e": 1272.49, "zh": "我们称之为“暗能量”。"}, {"s": 1274.75, "e": 1278.22, "zh": "而这种东西是宇宙的主要成分"}, {"s": 1278.26, "e": 1280.99, "zh": "几乎占宇宙物质-能量总量的四分之三"}, {"s": 1280.99, "e": 1283.5, "zh": "都是这种暗能量"}, {"s": 1283.53, "e": 1285.75, "zh": "而我们不知道它是什么。"}, {"s": 1289.72, "e": 1292.19, "zh": "暗能量与物质或辐射不同，"}, {"s": 1292.23, "e": 1295.21, "zh": "它不会随着宇宙膨胀而稀释。"}, {"s": 1296.5, "e": 1298.72, "zh": "这对宇宙未来的走向"}, {"s": 1298.75, "e": 1301.73, "zh": "有着至关重要的影响。"}, {"s": 1303.25, "e": 1305.47, "zh": "那么，宇宙的未来会怎样？"}, {"s": 1307.75, "e": 1311.02, "zh": "如果暗能量继续保持主导地位且具有排斥性，"}, {"s": 1312.23, "e": 1314.78, "zh": "宇宙将永远膨胀下去。"}, {"s": 1320.51, "e": 1323.51, "zh": "随着时间越来越快、越来越快——"}, {"s": 1324.23, "e": 1326.23, "zh": "一个失控的宇宙。"}, {"s": 1328.27, "e": 1331.02, "zh": "宇宙70%的能量"}, {"s": 1331.08, "e": 1335.74, "zh": "存在于虚空之中，而我们不明白为什么。"}, {"s": 1337.51, "e": 1339.75, "zh": "但我们确实知道会发生什么。"}, {"s": 1341.25, "e": 1343.75, "zh": "如果那股能量继续存在，"}, {"s": 1343.81, "e": 1347.24, "zh": "宇宙将变得寒冷、黑暗而空无。"}, {"s": 1350.0, "e": 1352.02, "zh": "那或许是未来的样子。"}, {"s": 1353.01, "e": 1354.5, "zh": "我们不知道，因为"}, {"s": 1354.54, "e": 1357.25, "zh": "我们还不了解暗能量的本质。"}, {"s": 1357.28, "e": 1357.97, "zh": "在我们弄清楚之前，"}, {"s": 1358.02, "e": 1359.52, "zh": "我们无法预知未来，"}, {"s": 1359.56, "e": 1361.74, "zh": "甚至无法理解自身的起源"}, {"s": 1361.78, "e": 1363.25, "zh": "这正是我们想探究"}, {"s": 1363.25, "e": 1365.24, "zh": "并研究这一课题的原因。"}, {"s": 1367.1, "e": 1374.23, "zh": "“揭示暗能量的真正本质，可能会彻底改变我们对未来的想象。”"}, {"s": 1375.89, "e": 1382.9, "zh": "“如果它随着时间推移而减弱，宇宙可能会在引力作用下坍缩——即‘大挤压’。”"}, {"s": 1384.1, "e": 1390.23, "zh": "“如果它增强，则可能把宇宙撕扯开来——即‘大撕裂’。”"}, {"s": 1392.49, "e": 1402.02, "zh": "[黑洞时代] “物理学家越来越怀疑，在我们宇宙之外可能还存在多个宇宙，每个宇宙都有各自独特的物理定律。”"}, {"s": 1405.07, "e": 1413.74, "zh": "“有些可能具备适合生命存在的条件，另一些则可能坍缩或被撕裂。”"}, {"s": 1415.37, "e": 1421.59, "zh": "“其他文明可能远比我们想象的更为奇特。”"}, {"s": 1426.07, "e": 1431.88, "zh": "“这个谜题的新碎片就在某处，等待被发现。”"}, {"s": 1432.58, "e": 1434.47, "zh": "预测似乎指向"}, {"s": 1434.47, "e": 1438.27, "zh": "一个越来越冷、越来越空旷的宇宙。"}, {"s": 1442.98, "e": 1444.72, "zh": "但当然，我们得问，"}, {"s": 1444.72, "e": 1448.0, "zh": "“那个终结会不会带来新的开端？”"}, {"s": 1450.49, "e": 1453.49, "zh": "确实有一些想法认为，我们宇宙的终结"}, {"s": 1453.49, "e": 1455.33, "zh": "在某种意义上，"}, {"s": 1455.33, "e": 1457.49, "zh": "可能引出新宇宙的诞生。"}, {"s": 1463.09, "e": 1469.63, "zh": "“有人推测，或许有办法在熵抹除一切之前逃离我们的宇宙。”"}, {"s": 1472.06, "e": 1478.05, "zh": "“我们可以创建模拟的虚拟宇宙，或者用足够的能量，造出一个和我们一样的宇宙。”"}, {"s": 1483.51, "e": 1484.97, "zh": "我们推导出了数学，"}, {"s": 1484.97, "e": 1485.75, "zh": "那些方程，"}, {"s": 1485.75, "e": 1486.74, "zh": "它们似乎在说，"}, {"s": 1486.74, "e": 1488.76, "zh": "如果你有一台原子粉碎机，"}, {"s": 1488.76, "e": 1490.75, "zh": "能把巨大的"}, {"s": 1490.75, "e": 1492.99, "zh": "能量聚集在单一点上，"}, {"s": 1492.99, "e": 1495.51, "zh": "你也许就能打开一道门——"}, {"s": 1495.51, "e": 1496.57, "zh": "一个“婴儿宇宙”"}, {"s": 1502.74, "e": 1506.25, "zh": "面对万物的死亡"}, {"s": 1506.25, "e": 1509.97, "zh": "这或许是他们唯一的逃生可能。"}, {"s": 1511.73, "e": 1515.01, "zh": "这也引出了一个非常耐人寻味的可能性，"}, {"s": 1515.01, "e": 1516.78, "zh": "当然，这纯粹是猜测，"}, {"s": 1517.02, "e": 1520.77, "zh": "那就是任何存在智慧生命的宇宙，"}, {"s": 1520.85, "e": 1523.74, "zh": "或许都会创造婴儿宇宙，创造“救生艇”，"}, {"s": 1523.79, "e": 1525.94, "zh": "并繁衍出子宇宙。"}, {"s": 1525.94, "e": 1527.6, "zh": "并繁衍出子宇宙。[最后一个黑洞蒸发]"}, {"s": 1529.74, "e": 1533.5, "zh": "于是，宇宙之间可能会发生演化，[最后一个黑洞蒸发]"}, {"s": 1533.5, "e": 1534.5, "zh": "在多元宇宙之中。[最后一个黑洞蒸发]"}, {"s": 1534.76, "e": 1538.73, "zh": "适者生存也许会发生。"}, {"s": 1538.73, "e": 1542.25, "zh": "所以那些没有智慧生命的宇宙是“不育的”，"}, {"s": 1542.25, "e": 1543.47, "zh": "它们没有后代。"}, {"s": 1543.75, "e": 1545.39, "zh": "但那些拥有"}, {"s": 1545.39, "e": 1547.77, "zh": "温和温度、像我们这样的恒星的宇宙，"}, {"s": 1547.77, "e": 1550.98, "zh": "会创造出能够开启子宇宙的文明，"}, {"s": 1550.98, "e": 1554.24, "zh": "然后它们就会繁衍开来。"}, {"s": 1559.25, "e": 1565.82, "zh": "“如果无法逃离宇宙，那么熵将继续增长，摧毁最后剩下的超大质量黑洞。”"}, {"s": 1568.97, "e": 1573.32, "zh": "“当最后一个爆炸消亡时，它会最后一次以光芒照亮宇宙。”"}, {"s": 1573.32, "e": 1575.79, "zh": "[黑洞时代] “当最后一个爆炸消亡时，它会最后一次以光芒照亮宇宙。”"}, {"s": 1575.79, "e": 1576.63, "zh": "[最后一个黑洞蒸发] “当最后一个爆炸消亡时，它会最后一次以光芒照亮宇宙。”"}, {"s": 1644.48, "e": 1647.75, "zh": "经过难以想象漫长的时间后，"}, {"s": 1647.83, "e": 1650.97, "zh": "连黑洞也将蒸发殆尽，"}, {"s": 1651.04, "e": 1652.76, "zh": "宇宙将只剩下"}, {"s": 1652.83, "e": 1655.98, "zh": "一片光子海洋，"}, {"s": 1656.06, "e": 1659.0, "zh": "逐渐趋向相同温度，"}, {"s": 1659.06, "e": 1661.88, "zh": "随着宇宙膨胀使其冷却，"}, {"s": 1661.92, "e": 1663.49, "zh": "逼近绝对零度。"}, {"s": 1677.49, "e": 1679.25, "zh": "一旦最后一批恒星的"}, {"s": 1679.29, "e": 1681.24, "zh": "最后残骸"}, {"s": 1681.29, "e": 1684.24, "zh": "最终衰变为虚无，"}, {"s": 1684.29, "e": 1687.17, "zh": "且一切达到相同温度，"}, {"s": 1687.24, "e": 1691.49, "zh": "宇宙的故事终于走向终结。"}, {"s": 1692.37, "e": 1694.88, "zh": "“时间失去意义”"}, {"s": 1694.88, "e": 1696.95, "zh": "宇宙有生以来第一次，“时间失去意义”"}, {"s": 1696.95, "e": 1700.51, "zh": "宇宙将永恒不变。“时间失去意义”"}, {"s": 1700.51, "e": 1701.31, "zh": "“时间失去意义”"}, {"s": 1701.31, "e": 1704.06, "zh": "熵终于停止增长，“时间失去意义”"}, {"s": 1704.06, "e": 1707.97, "zh": "因为宇宙再也无法变得更无序。“时间失去意义”"}, {"s": 1707.97, "e": 1708.65, "zh": "“时间失去意义”"}, {"s": 1708.65, "e": 1708.78, "zh": "什么都不会发生，“时间失去意义”"}, {"s": 1708.78, "e": 1708.9, "zh": "什么都不会发生，“时间失去意义"}, {"s": 1708.9, "e": 1709.03, "zh": "什么都不会发生，“时间失去意义，"}, {"s": 1709.03, "e": 1709.15, "zh": "什么都不会发生，“时间失去意义，"}, {"s": 1709.15, "e": 1709.28, "zh": "什么都不会发生，“时间失去意义，永"}, {"s": 1709.28, "e": 1709.4, "zh": "什么都不会发生，“时间失去意义，永永"}, {"s": 1709.4, "e": 1709.53, "zh": "什么都不会发生，“时间失去意义，永永永"}, {"s": 1709.53, "e": 1709.65, "zh": "什么都不会发生，“时间失去意义，永永永永"}, {"s": 1709.65, "e": 1709.78, "zh": "什么都不会发生，“时间失去意义，永永永永永"}, {"s": 1709.78, "e": 1709.9, "zh": "什么都不会发生，“时间失去意义，永永永永永永"}, {"s": 1709.9, "e": 1710.03, "zh": "什么都不会发生，“时间失去意义，永永远远"}, {"s": 1710.03, "e": 1710.4, "zh": "什么都不会发生，“时间失去意义，永永远远。"}, {"s": 1710.4, "e": 1712.12, "zh": "可它始终没有发生，“时间变得毫无意义，永远如此。"}, {"s": 1712.12, "e": 1713.01, "zh": "“时间变得毫无意义，永远如此。"}, {"s": 1713.01, "e": 1713.79, "zh": "“时间变得毫无意义，永远如此。”"}, {"s": 1713.79, "e": 1715.3, "zh": "“时间变得毫无意义，永远如此。”"}, {"s": 1717.23, "e": 1725.08, "zh": "“万物皆有奇妙之处，即便是黑暗与寂静……我也学会，无论身处何种境遇，都安之若素。”——Helen Keller"}, {"s": 1727.79, "e": 1731.96, "zh": "由 MELODYSHEEP 制作"}, {"s": 1733.36, "e": 1733.97, "zh": "支持方："}, {"s": 1733.97, "e": 1735.91, "zh": "支持方：Protocol Labs"}, {"s": 1735.91, "e": 1736.33, "zh": "Protocol Labs"}, {"s": 1736.33, "e": 1736.89, "zh": "Protocol Labs 你会探索什么？"}, {"s": 1736.89, "e": 1738.6, "zh": "Protocol Labs 你会探索什么？你将如何改变未来？"}, {"s": 1738.6, "e": 1738.99, "zh": "你会探索什么？你将如何改变未来？"}, {"s": 1739.5, "e": 1740.5, "zh": "配音阵容："}, {"s": 1740.5, "e": 1740.75, "zh": "配音阵容：David Attenborough"}, {"s": 1740.75, "e": 1741.0, "zh": "配音阵容：Craig Childs"}, {"s": 1741.0, "e": 1741.25, "zh": "配音阵容：Brian Cox"}, {"s": 1741.25, "e": 1741.5, "zh": "配音阵容：Neil Degrasse Tyson"}, {"s": 1741.5, "e": 1741.75, "zh": "配音阵容：Michelle Thaller"}, {"s": 1741.75, "e": 1742.0, "zh": "配音阵容：Lawrence Krauss"}, {"s": 1742.0, "e": 1742.25, "zh": "配音阵容：Michio Kaku"}, {"s": 1742.25, "e": 1742.5, "zh": "配音阵容：Mike Rowe"}, {"s": 1742.5, "e": 1742.75, "zh": "配音阵容：Phil Plait"}, {"s": 1742.75, "e": 1743.0, "zh": "配音阵容：Janna Levin"}, {"s": 1743.0, "e": 1743.25, "zh": "配音阵容：Stephen Hawking"}, {"s": 1743.25, "e": 1743.5, "zh": "配音阵容：Sean Carroll"}, {"s": 1743.5, "e": 1743.75, "zh": "配音阵容：Alex Filippenko"}, {"s": 1743.75, "e": 1744.54, "zh": "配音阵容：Martin Rees"}, {"s": 1745.6, "e": 1749.63, "zh": "感谢：Juan Benet 以及我在 Patreon 上的支持者 Patreon.com/melodysheep"}, {"s": 1751.08, "e": 1753.61, "zh": "MELODYSHEEP.COM | @MUSICALSCIENCE"}, {"s": 1755.06, "e": 1756.46, "zh": "献给 Ash"}]}