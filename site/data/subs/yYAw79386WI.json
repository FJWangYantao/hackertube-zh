{"vid": "yYAw79386WI", "model": "workbuddy-vps/cn:fast-model", "source": "yYAw79386WI.en.vtt", "cues": [{"s": 110.71, "e": 113.82, "zh": "这样的队形需要长时间"}, {"s": 113.83, "e": 115.68, "zh": "高强度训练和细致的"}, {"s": 115.69, "e": 118.11, "zh": "判断，当马队转过"}, {"s": 118.12, "e": 120.45, "zh": "弯道时，外侧的骑手"}, {"s": 120.46, "e": 122.88, "zh": "必须调整速度，以便"}, {"s": 122.89, "e": 126.42, "zh": "与内侧的骑手保持"}, {"s": 126.43, "e": 127.95, "zh": "齐平，外侧的人必须"}, {"s": 127.96, "e": 130.56, "zh": "骑得更远也更快，才能"}, {"s": 130.57, "e": 134.13, "zh": "跟上外面的巡游队伍"}, {"s": 134.14, "e": 136.92, "zh": "外侧车轮必须转得比内侧车轮更快"}, {"s": 136.93, "e": 139.08, "zh": "因为它们在相同时间内"}, {"s": 139.09, "e": 141.33, "zh": "要行进更远的距离"}, {"s": 141.34, "e": 144.3, "zh": "当马车转弯时，轮子可以以这样的速度行进"}, {"s": 144.31, "e": 146.49, "zh": "这段时间的长度"}, {"s": 146.5, "e": 148.92, "zh": "因为每个轮子都能"}, {"s": 148.93, "e": 152.01, "zh": "在轴上自由转动，而在"}, {"s": 152.02, "e": 154.59, "zh": "早期的汽车上，后轮转动"}, {"s": 154.6, "e": 156.99, "zh": "分别只有一个轮子"}, {"s": 157.0, "e": 160.2, "zh": "连接到发动机，但当时只有"}, {"s": 160.21, "e": 162.78, "zh": "一个轮子由发动机驱动时"}, {"s": 162.79, "e": 165.15, "zh": "它必须承担所有的工作，而且它无法"}, {"s": 165.16, "e": 167.55, "zh": "在路面上获得足够的抓地力来"}, {"s": 167.56, "e": 170.64, "zh": "正常发挥作用，所以单轮驱动"}, {"s": 170.65, "e": 174.24, "zh": "很快就过时了，但如果两个轮子"}, {"s": 174.25, "e": 176.67, "zh": "锁在一个轴上，使它们"}, {"s": 176.68, "e": 179.67, "zh": "不能各自独立转动，其中一个"}, {"s": 179.68, "e": 183.15, "zh": "或另一个就会打滑，因此工程师们不得不"}, {"s": 183.16, "e": 185.4, "zh": "找到一种方法，将两个后轮"}, {"s": 185.41, "e": 187.89, "zh": "都连接到发动机上，同时在转弯时"}, {"s": 187.9, "e": 191.37, "zh": "不打滑、不空转，实现这一点的装置"}, {"s": 191.38, "e": 194.36, "zh": "是后轴的一部分"}, {"s": 194.37, "e": 198.45, "zh": "它被称为差速器，因为它"}, {"s": 198.46, "e": 201.0, "zh": "能以不同的速度驱动后轮"}, {"s": 201.01, "e": 203.49, "zh": "差速器看起来"}, {"s": 203.5, "e": 206.22, "zh": "很复杂，但一旦我们理解了它的"}, {"s": 206.23, "e": 209.7, "zh": "这个原理非常简单"}, {"s": 209.71, "e": 212.1, "zh": "两个轮子安装在各自的轴上"}, {"s": 212.11, "e": 215.58, "zh": "并由一个框架支撑，使它们"}, {"s": 215.59, "e": 219.2, "zh": "能以不同速度自由旋转"}, {"s": 219.21, "e": 223.68, "zh": "我们在每根轴的内端固定一根辐条"}, {"s": 223.69, "e": 228.44, "zh": "这样转动辐条"}, {"s": 228.45, "e": 235.83, "zh": "就能分别转动每个轮子"}, {"s": 235.84, "e": 240.25, "zh": "用一根横杆或横梁，我们可以"}, {"s": 240.26, "e": 243.7, "zh": "让两个轮子以相同方向、相同"}, {"s": 243.71, "e": 247.39, "zh": "速度转动。我们找个东西"}, {"s": 247.4, "e": 249.97, "zh": "把这个横杆固定住，让它"}, {"s": 249.98, "e": 253.48, "zh": "压在辐条上。注意"}, {"s": 253.49, "e": 255.94, "zh": "这个支撑件并没有锁死在轴上"}, {"s": 255.95, "e": 260.38, "zh": "它可以自由转动。现在我们可以通过"}, {"s": 260.39, "e": 264.1, "zh": "转动支撑件来带动轮子旋转。只要"}, {"s": 264.11, "e": 266.98, "zh": "两个轮子能以相同速度转动"}, {"s": 266.99, "e": 270.79, "zh": "这没问题，但我们来看看"}, {"s": 270.8, "e": 272.44, "zh": "当我们转过这个弯"}, {"s": 272.45, "e": 275.92, "zh": "在这种情况下，我们无法"}, {"s": 275.93, "e": 280.56, "zh": "让一个轮子比另一个转得更快"}, {"s": 280.57, "e": 287.47, "zh": "而且如果我们停住一个轮子，另一个轮子"}, {"s": 287.48, "e": 292.6, "zh": "也无法转动。让我们把这根杆放在一个"}, {"s": 292.61, "e": 296.38, "zh": "支点上，这样它就能向任意"}, {"s": 296.39, "e": 302.62, "zh": "方向摆动"}, {"s": 302.63, "e": 306.76, "zh": "现在这根杆仍能以相同速度"}, {"s": 306.77, "e": 311.73, "zh": "带动两个轮子，而且因为它可以绕支点转动"}, {"s": 311.74, "e": 315.91, "zh": "它能让一个轮子转动，即使另一个"}, {"s": 315.92, "e": 320.32, "zh": "已经停下；但如果转得太远"}, {"s": 320.33, "e": 323.77, "zh": "横杆就会摆过去，直到无法"}, {"s": 323.78, "e": 326.5, "zh": "驱动带动轮子的辐条"}, {"s": 326.51, "e": 330.16, "zh": "我们需要另一根横杆和更多辐条"}, {"s": 330.17, "e": 334.54, "zh": "来在我们停下一个轮子时继续工作"}, {"s": 334.55, "e": 338.11, "zh": "横杆会继续"}, {"s": 338.12, "e": 340.59, "zh": "推动自由轮的辐条转动"}, {"s": 340.6, "e": 345.42, "zh": "只要两个轮子都能自由转动"}, {"s": 345.43, "e": 349.2, "zh": "横杆不会绕支点摆动，"}, {"s": 349.21, "e": 354.34, "zh": "车轮现在以相同速度转动，我们"}, {"s": 354.35, "e": 356.77, "zh": "掌握了差速器的工作原理，"}, {"s": 356.78, "e": 359.8, "zh": "可以改造这个模型投入实际使用。"}, {"s": 359.81, "e": 362.62, "zh": "在汽车里，我们得做一些改动"}, {"s": 362.63, "e": 366.16, "zh": "来减少因轮辐之间间隙过大"}, {"s": 366.17, "e": 369.73, "zh": "引起的顿挫感"}, {"s": 369.74, "e": 376.86, "zh": "我们会增加更多的轮辐"}, {"s": 376.87, "e": 379.09, "zh": "进一步填补"}, {"s": 379.1, "e": 382.0, "zh": "辐条之间的空隙，能让运转更平稳、"}, {"s": 382.01, "e": 384.97, "zh": "更连续，而改变形状"}, {"s": 384.98, "e": 390.25, "zh": "则能实现稳固、持续的接触。现在我们可以"}, {"s": 390.26, "e": 392.56, "zh": "把齿轮做得更厚、更结实，"}, {"s": 392.57, "e": 397.3, "zh": "于是就有了差速齿轮。齿边经过"}, {"s": 397.31, "e": 399.52, "zh": "切削，使它们能更"}, {"s": 399.53, "e": 401.2, "zh": "平滑、安静地啮合。"}, {"s": 401.21, "e": 404.38, "zh": "又加入一个齿轮来分担"}, {"s": 404.39, "e": 407.02, "zh": "驱动车轴的工作原理"}, {"s": 407.03, "e": 410.56, "zh": "是相同的，为了转动支架"}, {"s": 410.57, "e": 413.77, "zh": "并驱动车轮，我们可以在这里固定一个"}, {"s": 413.78, "e": 418.18, "zh": "大齿轮，由一个小齿轮连接"}, {"s": 418.19, "e": 427.78, "zh": "连接动力源"}, {"s": 427.79, "e": 430.25, "zh": "注意动力连接到了"}, {"s": 430.26, "e": 435.29, "zh": "中心线上的差速器，我们"}, {"s": 435.3, "e": 438.02, "zh": "可以通过把齿轮移得更近来让模型更紧凑"}, {"s": 438.03, "e": 441.77, "zh": "当我们将"}, {"s": 441.78, "e": 444.26, "zh": "把我们的差速器装进汽车时"}, {"s": 444.27, "e": 445.81, "zh": "得给传动轴留出空间"}, {"s": 445.82, "e": 449.26, "zh": "传动轴负责把动力从发动机传过来"}, {"s": 449.27, "e": 451.79, "zh": "我们可以把车底板建在"}, {"s": 451.8, "e": 457.01, "zh": "传动轴上方，但这样一来"}, {"s": 457.02, "e": 459.47, "zh": "车内空间就不大了，除非"}, {"s": 459.48, "e": 463.01, "zh": "把车顶做得很高——当然"}, {"s": 463.02, "e": 465.23, "zh": "也可以降低底板和车顶，但那样"}, {"s": 465.24, "e": 467.18, "zh": "传动轴就会高过"}, {"s": 467.19, "e": 471.38, "zh": "把地板弄成这样会有缺点，我们的"}, {"s": 471.39, "e": 473.06, "zh": "竖井位于地板中间，一个"}, {"s": 473.07, "e": 475.34, "zh": "对汽车来说会很不方便"}, {"s": 475.35, "e": 477.62, "zh": "乘客会觉得别扭，"}, {"s": 477.63, "e": 481.55, "zh": "如今携带行李，工程师们已经"}, {"s": 481.56, "e": 483.44, "zh": "找到了一种让车内更宽敞、更贴近路面的方法"}, {"s": 483.45, "e": 486.05, "zh": "又不会在地板上留下笨拙的"}, {"s": 486.06, "e": 489.47, "zh": "传动轴，从发动机到差速器的"}, {"s": 489.48, "e": 492.38, "zh": "传动轴被降到不碍事的位置，"}, {"s": 492.39, "e": 495.41, "zh": "并且驱动"}, {"s": 495.42, "e": 497.78, "zh": "shaft 连接到后轴，位于"}, {"s": 497.79, "e": 500.72, "zh": "底部。新的低重心驱动"}, {"s": 500.73, "e": 504.44, "zh": "让后轴更安静、更强壮、"}, {"s": 504.45, "e": 507.47, "zh": "更耐用，因为它使齿轮之间"}, {"s": 507.48, "e": 512.18, "zh": "接触得更好、更平稳。"}, {"s": 512.19, "e": 514.79, "zh": "如今的汽车，重心低"}, {"s": 514.8, "e": 519.74, "zh": "驱动更强、更坚固，每一处"}, {"s": 519.75, "e": 522.11, "zh": "后桥部件都经过精心打造，能够"}, {"s": 522.12, "e": 525.23, "zh": "承受远超其"}, {"s": 525.24, "e": 527.63, "zh": "在直道上所会遇到的应力，更"}, {"s": 527.64, "e": 529.09, "zh": "能应对弯道"}]}