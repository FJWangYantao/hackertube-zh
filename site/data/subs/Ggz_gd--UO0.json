{"vid": "Ggz_gd--UO0", "model": "workbuddy-vps/global:deepseek-v4.1-flash", "source": "Ggz_gd--UO0.en.vtt", "cues": [{"s": 0.48, "e": 1.83, "zh": "谢谢主席先生，各位"}, {"s": 1.84, "e": 4.71, "zh": "委员会成员。我很高兴再次来到"}, {"s": 4.72, "e": 6.87, "zh": "司法委员会面前，我"}, {"s": 6.88, "e": 9.91, "zh": "就是从这里开始这段，呃"}, {"s": 9.92, "e": 13.11, "zh": "历程的。呃，我要讲得甚至"}, {"s": 13.12, "e": 16.63, "zh": "比，呃，我的好"}, {"s": 16.64, "e": 18.35, "zh": "朋友兼"}, {"s": 18.36, "e": 22.55, "zh": "同事还要更根本一些。像他一样，我经常，呃，对"}, {"s": 22.56, "e": 24.51, "zh": "学生讲话，尤其是法学院学生，但"}, {"s": 24.52, "e": 26.11, "zh": "也包括大学生，甚至高中"}, {"s": 26.12, "e": 28.43, "zh": "学生，经常谈"}, {"s": 28.44, "e": 30.67, "zh": "宪法，呃"}, {"s": 30.68, "e": 32.99, "zh": "因为我觉得我们并没有"}, {"s": 33.0, "e": 34.39, "zh": "把它教得"}, {"s": 34.4, "e": 38.95, "zh": "很好。嗯，我对来自"}, {"s": 38.96, "e": 41.75, "zh": "最顶尖法学院的法学学生讲话，这些人"}, {"s": 41.76, "e": 43.95, "zh": "想必尤其对"}, {"s": 43.96, "e": 46.11, "zh": "法律感兴趣。我问他们：你们有多少人"}, {"s": 46.12, "e": 47.99, "zh": "读过《联邦党人文集》"}, {"s": 48.0, "e": 50.79, "zh": "？结果很多人会"}, {"s": 50.8, "e": 53.51, "zh": "放下手。不是只读第48篇和那些名篇"}, {"s": 53.52, "e": 55.23, "zh": "你们有多少人读过《联邦党人文集》"}, {"s": 55.24, "e": 58.07, "zh": "从头到尾？从不超过"}, {"s": 58.08, "e": 63.59, "zh": "大约5%。这很可悲。我是说，如果"}, {"s": 63.6, "e": 65.07, "zh": "尤其是如果你对"}, {"s": 65.08, "e": 67.55, "zh": "宪法感兴趣，这份文件说明了"}, {"s": 67.56, "e": 69.35, "zh": "它的制宪者认为自己当时在"}, {"s": 69.36, "e": 73.15, "zh": "做什么。它是如此深刻的"}, {"s": 73.16, "e": 76.19, "zh": "政治学阐述，以至于它"}, {"s": 76.2, "e": 78.39, "zh": "被欧洲的政治学"}, {"s": 78.4, "e": 80.95, "zh": "课程研究。然而我们却"}, {"s": 80.96, "e": 82.79, "zh": "培养了一代美国人，他们"}, {"s": 82.8, "e": 85.63, "zh": "对它并不熟悉。所以当我"}, {"s": 85.64, "e": 87.51, "zh": "对这些"}, {"s": 87.52, "e": 90.95, "zh": "团体讲话时，我提出的第一点，而且我"}, {"s": 90.96, "e": 92.55, "zh": "认为它甚至比"}, {"s": 92.56, "e": 95.19, "zh": "那一点还要更根本一些，呃，Steven"}, {"s": 95.2, "e": 97.19, "zh": "刚刚，呃，提出"}, {"s": 97.2, "e": 100.35, "zh": "的那一点。我问"}, {"s": 100.36, "e": 102.99, "zh": "你们觉得原因是什么"}, {"s": 103.0, "e": 106.19, "zh": "美国为什么是这样一个自由的国家，是什么"}, {"s": 106.2, "e": 110.39, "zh": "是我们宪法里的什么，那个"}, {"s": 110.4, "e": 112.71, "zh": "造就了今天的我们，而我"}, {"s": 112.72, "e": 115.51, "zh": "向你们保证，我会得到的回答"}, {"s": 115.52, "e": 117.55, "zh": "以及你几乎会从"}, {"s": 117.56, "e": 119.43, "zh": "任何美国人那里得到，包括他"}, {"s": 119.44, "e": 121.99, "zh": "在超市交谈的那位女士"}, {"s": 122.0, "e": 124.99, "zh": "答案会是言论自由"}, {"s": 125.0, "e": 127.63, "zh": "新闻自由，没有不合理的"}, {"s": 127.64, "e": 130.03, "zh": "搜查和扣押，不得驻扎"}, {"s": 130.04, "e": 131.55, "zh": "军队在民宅——那些绝妙的"}, {"s": 131.56, "e": 133.83, "zh": "《权利法案》条款"}, {"s": 133.84, "e": 136.91, "zh": "但然后我告诉他们，如果如果你们"}, {"s": 136.92, "e": 138.99, "zh": "认为一部《权利法案》"}, {"s": 139.0, "e": 142.19, "zh": "是让我们与众不同的东西，那你就"}, {"s": 142.2, "e": 145.23, "zh": "疯了，世界上每个香蕉共和国"}, {"s": 145.24, "e": 148.27, "zh": "都有一部《权利法案》，每个终身"}, {"s": 148.28, "e": 151.63, "zh": "总统都有一部《权利法案》，那部《权利"}, {"s": 151.64, "e": 153.67, "zh": "法案》，前邪恶帝国的"}, {"s": 153.68, "e": 155.99, "zh": "苏维埃社会主义共和国联盟"}, {"s": 156.0, "e": 157.67, "zh": "比我们的好得多，我是说"}, {"s": 157.68, "e": 160.35, "zh": "真的，它好得多，我们"}, {"s": 160.36, "e": 161.87, "zh": "保障言论自由和"}, {"s": 161.88, "e": 163.79, "zh": "新闻自由，有什么了不起，他们保障了"}, {"s": 163.8, "e": 165.35, "zh": "言论自由、新闻自由、街头"}, {"s": 165.36, "e": 167.87, "zh": "示威和抗议，而且任何人"}, {"s": 167.88, "e": 171.35, "zh": "如果被发现试图压制"}, {"s": 171.36, "e": 172.99, "zh": "对政府的批评，将会"}, {"s": 173.0, "e": 175.23, "zh": "被追究责任。哇，那那真是"}, {"s": 175.24, "e": 177.99, "zh": "奇妙的东西，"}, {"s": 178.0, "e": 181.31, "zh": "当然，只是纸上的文字，我们的"}, {"s": 181.32, "e": 183.91, "zh": "制宪者会称之为一纸"}, {"s": 183.92, "e": 187.19, "zh": "保证，而原因在于"}, {"s": 187.2, "e": 190.75, "zh": "苏联的真正宪法"}, {"s": 190.76, "e": 192.43, "zh": "你想到“宪法”这个词，它"}, {"s": 192.44, "e": 194.83, "zh": "不是指一项法案，而是指结构，比如说"}, {"s": 194.84, "e": 196.83, "zh": "一个人有健全的体质，这里有一个"}, {"s": 196.84, "e": 199.51, "zh": "健全的结构，真正的宪法，属于"}, {"s": 199.52, "e": 202.43, "zh": "苏联，这正是我们的"}, {"s": 202.44, "e": 204.63, "zh": "制宪者所辩论的，那个那个整个"}, {"s": 204.64, "e": 207.31, "zh": "1787年在费城的那个夏天，他们"}, {"s": 207.32, "e": 208.63, "zh": "没有谈论《权利法案》"}, {"s": 208.64, "e": 210.71, "zh": "那是事后才想到的，不是吗"}, {"s": 210.72, "e": 214.11, "zh": "它，苏联的那部宪法"}, {"s": 214.12, "e": 216.63, "zh": "没有阻止把权力集中"}, {"s": 216.64, "e": 221.19, "zh": "到一个人或一个政党手中，而"}, {"s": 221.2, "e": 223.63, "zh": "一旦发生这种情况，游戏就结束了"}, {"s": 223.64, "e": 226.71, "zh": "《权利法案》正是我们的制宪者"}, {"s": 226.72, "e": 230.91, "zh": "会称之为“羊皮纸保证”的东西，所以"}, {"s": 230.92, "e": 233.31, "zh": "真正的关键在于"}, {"s": 233.32, "e": 236.47, "zh": "呃，……的独特性"}, {"s": 236.48, "e": 238.79, "zh": "美国就在于我们……的结构"}, {"s": 238.8, "e": 240.91, "zh": "政府，其中一部分当然是"}, {"s": 240.92, "e": 242.67, "zh": "司法机构的独立性，但是"}, {"s": 242.68, "e": 245.19, "zh": "还有还有还有更多东西"}, {"s": 245.2, "e": 246.75, "zh": "世界上很少有国家，例如"}, {"s": 246.76, "e": 249.43, "zh": "例如，实行两院制"}, {"s": 249.44, "e": 251.55, "zh": "立法机构。哦，英国有上议院"}, {"s": 251.56, "e": 253.55, "zh": "暂时有上议院，但上议院"}, {"s": 253.56, "e": 255.67, "zh": "没有实质权力，他们只能"}, {"s": 255.68, "e": 258.23, "zh": "只是让下议院第二次通过法案"}, {"s": 258.24, "e": 260.91, "zh": "法国有参议院，那是荣誉性的"}, {"s": 260.92, "e": 263.51, "zh": "意大利有参议院，也是荣誉性的，非常"}, {"s": 263.52, "e": 266.67, "zh": "很少有国家有两个独立的机构"}, {"s": 266.68, "e": 268.71, "zh": "在立法机构中，同等"}, {"s": 268.72, "e": 271.39, "zh": "强大，这很麻烦，正如你们"}, {"s": 271.4, "e": 274.39, "zh": "先生们无疑知道，要让同样的"}, {"s": 274.4, "e": 276.79, "zh": "文本通过两个不同的机构"}, {"s": 276.8, "e": 279.03, "zh": "以不同方式选举产生"}, {"s": 279.04, "e": 282.75, "zh": "方式，世界上很少有国家"}, {"s": 282.76, "e": 285.95, "zh": "拥有一个单独选举产生的，呃"}, {"s": 285.96, "e": 287.11, "zh": "最高"}, {"s": 287.12, "e": 289.07, "zh": "行政官，有时我会去欧洲"}, {"s": 289.08, "e": 291.91, "zh": "谈论权力分立，而"}, {"s": 291.92, "e": 293.67, "zh": "到了那里我发现，我"}, {"s": 293.68, "e": 296.79, "zh": "谈的全是……的独立"}, {"s": 296.8, "e": 299.75, "zh": "司法机构，因为欧洲人根本不"}, {"s": 299.76, "e": 301.99, "zh": "试图划分这两个政治"}, {"s": 302.0, "e": 304.75, "zh": "权力，两个政治分支，"}, {"s": 304.76, "e": 307.87, "zh": "立法机关和行政首长，在"}, {"s": 307.88, "e": 309.87, "zh": "所有议会制国家，"}, {"s": 309.88, "e": 311.55, "zh": "行政首长是……的产物"}, {"s": 311.56, "e": 313.23, "zh": "立法机关。他们之间从来没有"}, {"s": 313.24, "e": 315.47, "zh": "分歧，他们和"}, {"s": 315.48, "e": 317.71, "zh": "首相之间也没有，就像"}, {"s": 317.72, "e": 319.87, "zh": "有时你和总统之间那样"}, {"s": 319.88, "e": 321.59, "zh": "当出现分歧时，他们"}, {"s": 321.6, "e": 323.67, "zh": "直接把他赶下台，他们有不"}, {"s": 323.68, "e": 325.71, "zh": "信任投票，重新选举，然后他们"}, {"s": 325.72, "e": 327.95, "zh": "得到一位与……意见一致的首相"}, {"s": 327.96, "e": 330.91, "zh": "立法机关。你知道，欧洲人"}, {"s": 330.92, "e": 333.03, "zh": "看这个制度，他们说，好吧，它"}, {"s": 333.04, "e": 334.95, "zh": "通过一院，却通不过"}, {"s": 334.96, "e": 336.83, "zh": "另一院，有时另一院由"}, {"s": 336.84, "e": 338.91, "zh": "不同政党控制，它"}, {"s": 338.92, "e": 340.95, "zh": "两院都通过了，然后这位总统拥有"}, {"s": 340.96, "e": 344.19, "zh": "否决权，把它否决了，他们看"}, {"s": 344.2, "e": 347.79, "zh": "到这些就说，呃，这真是"}, {"s": 347.8, "e": 350.35, "zh": "僵局。而且我听到美国人"}, {"s": 350.36, "e": 352.11, "zh": "现在也这么说，这种说法很"}, {"s": 352.12, "e": 354.15, "zh": "流行，他们谈论"}, {"s": 354.16, "e": 355.99, "zh": "一个失灵的"}, {"s": 356.0, "e": 357.91, "zh": "政府，因为存在"}, {"s": 357.92, "e": 360.23, "zh": "分歧，而他们，而"}, {"s": 360.24, "e": 362.43, "zh": "制宪者会说，对，这正是"}, {"s": 362.44, "e": 365.27, "zh": "我们设计的方式，我们"}, {"s": 365.28, "e": 369.23, "zh": "就是想让权力……呃，相互制衡"}, {"s": 369.24, "e": 372.79, "zh": "权力，因为主要的，呃，主要的弊病"}, {"s": 372.8, "e": 375.95, "zh": "困扰我们的弊病，正如汉密尔顿在"}, {"s": 375.96, "e": 377.79, "zh": "《联邦党人文集》中谈到"}, {"s": 377.8, "e": 379.67, "zh": "一个独立的参议院时所说，他说，是的，看起来"}, {"s": 379.68, "e": 382.11, "zh": "不方便，但既然主要的"}, {"s": 382.12, "e": 384.39, "zh": "困扰我们的弊病是过多的"}, {"s": 384.4, "e": 387.59, "zh": "立法，那也不会太糟。这是"}, {"s": 387.6, "e": 389.63, "zh": "1787年，他并不知道，过多的"}, {"s": 389.64, "e": 390.95, "zh": "立法"}, {"s": 390.96, "e": 395.27, "zh": "会如此，呃，除非美国人能"}, {"s": 395.28, "e": 398.11, "zh": "理解这一点，并学会、学会热爱"}, {"s": 398.12, "e": 400.03, "zh": "分权，这意味着"}, {"s": 400.04, "e": 401.51, "zh": "学会热爱"}, {"s": 401.52, "e": 404.11, "zh": "僵局，制宪者相信"}, {"s": 404.12, "e": 405.87, "zh": "它会是主要的保护机制，保护"}, {"s": 405.88, "e": 408.91, "zh": "少数派，主要保护，如果、如果一项"}, {"s": 408.92, "e": 410.71, "zh": "法案即将通过，而且真的会"}, {"s": 410.72, "e": 412.99, "zh": "严厉打击某个少数群体，他们认为"}, {"s": 413.0, "e": 415.35, "zh": "这极不公平，不需要"}, {"s": 415.36, "e": 417.43, "zh": "费多大劲就能从中作梗，把"}, {"s": 417.44, "e": 420.07, "zh": "这个、这个复杂系统搅乱"}, {"s": 420.08, "e": 423.07, "zh": "所以美国人应该，呃，应该理解"}, {"s": 423.08, "e": 424.39, "zh": "这一点，而且、而且他们应该学会热爱"}, {"s": 424.4, "e": 425.39, "zh": "这种"}, {"s": 425.4, "e": 429.47, "zh": "僵局，呃，它、它存在是有原因的"}, {"s": 429.48, "e": 431.27, "zh": "这样最终出炉的立法"}, {"s": 431.28, "e": 433.07, "zh": "才会、才会是好的"}, {"s": 433.08, "e": 437.71, "zh": "立法，呃，因此我结束，呃，我的"}, {"s": 437.72, "e": 441.12, "zh": "开场白"}]}