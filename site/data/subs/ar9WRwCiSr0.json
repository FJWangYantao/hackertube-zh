{"vid": "ar9WRwCiSr0", "model": "workbuddy-vps/cn:fast-model", "source": "ar9WRwCiSr0.en.vtt", "cues": [{"s": 0.08, "e": 3.62, "zh": "如果你一直在"}, {"s": 3.63, "e": 5.06, "zh": "关注我的频道，就知道我"}, {"s": 5.07, "e": 7.19, "zh": "喜欢做关于 Nintendo 的项目"}, {"s": 7.2, "e": 8.93, "zh": "我也喜欢做那种"}, {"s": 8.94, "e": 11.6, "zh": "有点幽默、技术上"}, {"s": 11.61, "e": 13.94, "zh": "也算幽默的项目，所以我们就来做这样一个"}, {"s": 13.95, "e": 16.22, "zh": "我们要讲一个笑话，我要给你讲一个"}, {"s": 16.23, "e": 18.8, "zh": "笑话，不过在开始之前"}, {"s": 18.81, "e": 20.72, "zh": "我想，我觉得这个笑话效果更好"}, {"s": 20.73, "e": 24.02, "zh": "如果我们从里到外反过来讲，所以"}, {"s": 24.03, "e": 25.46, "zh": "首先我想先聊聊"}, {"s": 25.47, "e": 27.95, "zh": "什么是好笑，当然很多"}, {"s": 27.96, "e": 30.14, "zh": "自命不凡的人，甚至比我更"}, {"s": 30.15, "e": 32.12, "zh": "自命不凡的人研究过这个"}, {"s": 32.13, "e": 34.55, "zh": "问题，并因此把它风干成"}, {"s": 34.56, "e": 36.98, "zh": "某种干李子粉，研究了几百年"}, {"s": 36.99, "e": 39.77, "zh": "但请稍等我一会，那么"}, {"s": 39.78, "e": 42.68, "zh": "有个老古董说，如果"}, {"s": 42.69, "e": 44.81, "zh": "给我看一段一个人的影片"}, {"s": 44.82, "e": 46.61, "zh": "在吃靴子，而这个人"}, {"s": 46.62, "e": 48.47, "zh": "满头大汗，一脸厌恶"}, {"s": 48.48, "e": 51.2, "zh": "那不好笑。但另"}, {"s": 51.21, "e": 52.49, "zh": "一方面，如果给我看一段影片"}, {"s": 52.5, "e": 54.41, "zh": "里面的人表情一本正经"}, {"s": 54.42, "e": 56.09, "zh": "面部神态平静"}, {"s": 56.1, "e": 57.53, "zh": "在吃靴子，那就好笑了"}, {"s": 57.54, "e": 59.54, "zh": "其实我觉得这两件事都"}, {"s": 59.55, "e": 61.58, "zh": "不好笑。也许这是一种元幽默——"}, {"s": 61.59, "e": 63.8, "zh": "从前吃靴子曾"}, {"s": 63.81, "e": 66.74, "zh": "被视为闹剧幽默的巅峰"}, {"s": 66.75, "e": 68.84, "zh": "但这其中有点道理，就是"}, {"s": 68.85, "e": 71.0, "zh": "这个想法：如果我违背了你的"}, {"s": 71.01, "e": 73.43, "zh": "预期，幽默就藏在那里"}, {"s": 73.44, "e": 74.63, "zh": "我们再多做几个这样的例子，我"}, {"s": 74.64, "e": 75.92, "zh": "想，我想进入一个技术性"}, {"s": 75.93, "e": 76.37, "zh": "笑话"}, {"s": 76.38, "e": 79.34, "zh": "马里奥吃靴子，这不好笑"}, {"s": 79.35, "e": 81.38, "zh": "听这个笑话，哦，我看到一个超级马里奥"}, {"s": 81.39, "e": 84.02, "zh": "感觉挺复古的，我不觉得这本身"}, {"s": 84.03, "e": 86.44, "zh": "有什么好笑的，但另一方面"}, {"s": 86.45, "e": 89.75, "zh": "萨姆