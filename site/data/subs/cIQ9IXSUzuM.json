{"vid": "cIQ9IXSUzuM", "model": "workbuddy-vps/global:deepseek-v4.1-flash", "source": "cIQ9IXSUzuM.en.vtt", "cues": [{"s": 8.4, "e": 10.39, "zh": "嗨，我是 Monty Montgomery，来自 Red Hat 和"}, {"s": 10.4, "e": 12.71, "zh": "z.org。几个月前我写了一篇"}, {"s": 12.72, "e": 15.31, "zh": "关于数字音频的文章，以及为什么 24bit"}, {"s": 15.32, "e": 18.95, "zh": "192kHz 音乐下载没有意义"}, {"s": 18.96, "e": 21.15, "zh": "在那篇文章里，我几乎只是"}, {"s": 21.16, "e": 22.95, "zh": "顺带提到，数字波形不是"}, {"s": 22.96, "e": 25.03, "zh": "阶梯状，而且你绝不会得到"}, {"s": 25.04, "e": 27.35, "zh": "阶梯状，当你从数字"}, {"s": 27.36, "e": 28.75, "zh": "转回"}, {"s": 28.76, "e": 31.23, "zh": "模拟。整篇文章的"}, {"s": 31.24, "e": 33.11, "zh": "所有内容里，这是人们写得最多的"}, {"s": 33.12, "e": 34.99, "zh": "一件事。事实上，超过"}, {"s": 35.0, "e": 37.11, "zh": "一半的邮件都是问题和"}, {"s": 37.12, "e": 39.03, "zh": "关于基本数字信号"}, {"s": 39.04, "e": 41.51, "zh": "行为的评论。既然大家有兴趣，我们"}, {"s": 41.52, "e": 43.07, "zh": "花点时间玩一玩一些"}, {"s": 43.08, "e": 48.91, "zh": "简单的数字"}, {"s": 48.92, "e": 51.27, "zh": "信号。先假装我们"}, {"s": 51.28, "e": 54.39, "zh": "完全不知道数字信号到底"}, {"s": 54.4, "e": 56.51, "zh": "如何表现。那样的话，我们"}, {"s": 56.52, "e": 57.91, "zh": "使用数字测试"}, {"s": 57.92, "e": 60.27, "zh": "设备就没意义了。幸运的是，这次"}, {"s": 60.28, "e": 61.87, "zh": "练习中，仍然有很多能用的"}, {"s": 61.88, "e": 64.99, "zh": "模拟实验室设备。首先"}, {"s": 65.0, "e": 66.83, "zh": "我们需要一台信号发生器，给我们"}, {"s": 66.84, "e": 69.23, "zh": "提供模拟输入信号。这里用"}, {"s": 69.24, "e": 73.67, "zh": "一台 1978 年的 HP 3325。它仍然是一台相当"}, {"s": 73.68, "e": 75.55, "zh": "好的发生器。所以如果你不介意"}, {"s": 75.56, "e": 77.75, "zh": "尺寸、重量、功耗"}, {"s": 77.76, "e": 79.91, "zh": "和吵闹的风扇，你可以在"}, {"s": 79.92, "e": 82.27, "zh": "eBay 上偶尔找到它们，价格只比"}, {"s": 82.28, "e": 84.19, "zh": "你付的"}, {"s": 84.2, "e": 86.71, "zh": "运费略高。接下来，我们将在模拟"}, {"s": 86.72, "e": 88.99, "zh": "示波器上观察我们的模拟波形，比如"}, {"s": 89.0, "e": 91.99, "zh": "这台 90 年代中期的 Tektronix 2246，"}, {"s": 92.0, "e": 93.95, "zh": "它是最后一批、也是非常好的模拟"}, {"s": 93.96, "e": 96.11, "zh": "示波器？每个家庭实验室都应该有"}, {"s": 96.12, "e": 97.15, "zh": "一台"}, {"s": 97.16, "e": 99.99, "zh": "最后，再检查频率"}, {"s": 100.0, "e": 102.23, "zh": "查看我们信号的频谱，用一台模拟"}, {"s": 102.24, "e": 105.67, "zh": "频谱分析仪，这台 HP 3585 来自"}, {"s": 105.68, "e": 107.31, "zh": "与信号发生器同一产品线"}, {"s": 107.32, "e": 109.67, "zh": "像这里的其他设备一样"}, {"s": 109.68, "e": 111.91, "zh": "它有一个简陋又滑稽地"}, {"s": 111.92, "e": 113.95, "zh": "巨大的微控制器，但信号"}, {"s": 113.96, "e": 116.11, "zh": "从输入到你在屏幕上看到的"}, {"s": 116.12, "e": 119.31, "zh": "路径完全是模拟的。所有这些"}, {"s": 119.32, "e": 121.15, "zh": "设备都是老古董，但除了它"}, {"s": 121.16, "e": 123.75, "zh": "庞大的体量，规格仍然相当"}, {"s": 123.76, "e": 126.51, "zh": "不错。目前我们的信号"}, {"s": 126.52, "e": 129.95, "zh": "发生器设置为输出一个漂亮的 1 kHz"}, {"s": 129.96, "e": 134.43, "zh": "正弦波，1V RMS。我们在示波器上看到正弦波"}, {"s": 134.44, "e": 136.71, "zh": "可以验证它"}, {"s": 136.72, "e": 138.87, "zh": "确实是 1"}, {"s": 138.88, "e": 143.27, "zh": "kHz、1V RMS，也就是 2.8 V 峰"}, {"s": 143.28, "e": 145.83, "zh": "峰值，这也与测量"}, {"s": 145.84, "e": 147.67, "zh": "在频谱分析仪上吻合。分析仪还显示了一些"}, {"s": 147.68, "e": 149.95, "zh": "低电平白"}, {"s": 149.96, "e": 151.87, "zh": "噪声，以及一点点谐波"}, {"s": 151.88, "e": 154.39, "zh": "失真，最高峰大约"}, {"s": 154.4, "e": 157.27, "zh": "比基频低 70 dB 左右。现在"}, {"s": 157.28, "e": 159.11, "zh": "这在我们的演示里完全不影响"}, {"s": 159.12, "e": 161.19, "zh": "但我想现在指出来，以防"}, {"s": 161.2, "e": 163.43, "zh": "你直到后来才注意到"}, {"s": 163.44, "e": 167.71, "zh": "现在我们把数字采样放到"}, {"s": 167.72, "e": 170.39, "zh": "中间用于转换，我们会用一台"}, {"s": 170.4, "e": 173.11, "zh": "无聊的消费级 EIC USB1 音频"}, {"s": 173.12, "e": 175.43, "zh": "设备。它也超过 10 年了"}, {"s": 175.44, "e": 177.15, "zh": "到现在已经越来越"}, {"s": 177.16, "e": 180.55, "zh": "过时。新的转换器很容易"}, {"s": 180.56, "e": 183.47, "zh": "好一个数量级的规格"}, {"s": 183.48, "e": 186.55, "zh": "平坦度、线性度、抖动、噪声"}, {"s": 186.56, "e": 188.95, "zh": "表现：你可能没有"}, {"s": 188.96, "e": 191.27, "zh": "注意到，仅仅因为我们可以测量到"}, {"s": 191.28, "e": 193.83, "zh": "改进，并不意味着我们能听出来"}, {"s": 193.84, "e": 196.11, "zh": "而且即便是这些老式消费级设备"}, {"s": 196.12, "e": 199.51, "zh": "也已经处在理想"}, {"s": 199.52, "e": 201.99, "zh": "透明度的边缘。EIC 连接到我的"}, {"s": 202.0, "e": 203.99, "zh": "ThinkPad，它会显示数字"}, {"s": 204.0, "e": 206.51, "zh": "波形和频谱用于比较"}, {"s": 206.52, "e": 208.03, "zh": "然后 ThinkPad 将数字"}, {"s": 208.04, "e": 210.11, "zh": "信号直接送回 EIC，以便"}, {"s": 210.12, "e": 212.23, "zh": "重新转换为模拟信号并进行观察"}, {"s": 212.24, "e": 214.63, "zh": "在输出示波器上，从输入到输出"}, {"s": 214.64, "e": 219.39, "zh": "从左到"}, {"s": 219.4, "e": 222.23, "zh": "右。好，开始吧。我们首先"}, {"s": 222.24, "e": 224.27, "zh": "将模拟信号转换为数字信号"}, {"s": 224.28, "e": 226.31, "zh": "然后再直接转回模拟信号，"}, {"s": 226.32, "e": 228.87, "zh": "不经过其他步骤。信号发生器"}, {"s": 228.88, "e": 231.59, "zh": "设置为产生 1 kHz 正弦波，就"}, {"s": 231.6, "e": 232.43, "zh": "像"}, {"s": 232.44, "e": 235.47, "zh": "之前那样。我们能看到我们的模拟正弦波"}, {"s": 235.48, "e": 237.67, "zh": "在输入侧示波器上，我们"}, {"s": 237.68, "e": 241.39, "zh": "将信号数字化为 16 位 PCM，采样率 44.1"}, {"s": 241.4, "e": 244.55, "zh": "kHz，与 CD 相同。数字化信号的"}, {"s": 244.56, "e": 246.59, "zh": "频谱与我们之前看到的"}, {"s": 246.6, "e": 249.55, "zh": "以及现在在"}, {"s": 249.56, "e": 252.07, "zh": "模拟频谱分析仪上看到的一致，除了它的"}, {"s": 252.08, "e": 253.99, "zh": "高阻抗输入只是稍微"}, {"s": 254.0, "e": 257.39, "zh": "更噪一点。目前"}, {"s": 257.4, "e": 259.87, "zh": "波形显示将我们的"}, {"s": 259.88, "e": 261.99, "zh": "数字化正弦波显示为阶梯"}, {"s": 262.0, "e": 264.87, "zh": "图案，每个采样一步，并且"}, {"s": 264.88, "e": 266.39, "zh": "当我们查看输出信号，它已"}, {"s": 266.4, "e": 268.15, "zh": "从数字转换回"}, {"s": 268.16, "e": 270.99, "zh": "模拟，我们看到它完全就像"}, {"s": 271.0, "e": 273.31, "zh": "原始正弦波，没有阶梯"}, {"s": 273.32, "e": 276.67, "zh": "步。好，1 kHz 仍是相当低的"}, {"s": 276.68, "e": 278.67, "zh": "频率，也许阶梯只是"}, {"s": 278.68, "e": 280.39, "zh": "很难看清，还是它们正被平滑"}, {"s": 280.4, "e": 282.55, "zh": "掉——好吧，我们选个更高的"}, {"s": 282.56, "e": 288.67, "zh": "频率，接近奈奎斯特，比如 15"}, {"s": 288.68, "e": 291.55, "zh": "kHz。现在正弦波由"}, {"s": 291.56, "e": 294.03, "zh": "每个周期不到三个采样点，而且"}, {"s": 294.04, "e": 296.27, "zh": "数字波形看起来相当糟糕"}, {"s": 296.28, "e": 298.47, "zh": "嗯，表象会骗人。模拟"}, {"s": 298.48, "e": 301.91, "zh": "输出"}, {"s": 301.92, "e": 304.47, "zh": "仍然是一个完美的正弦波，完全"}, {"s": 304.48, "e": 306.07, "zh": "就像"}, {"s": 306.08, "e": 308.83, "zh": "原始信号一样。我们继续"}, {"s": 308.84, "e": 311.63, "zh": "往上。看看我能不能做到不"}, {"s": 311.64, "e": 316.43, "zh": "挡住任何"}, {"s": 316.44, "e": 322.03, "zh": "摄像头。16"}, {"s": 322.04, "e": 327.31, "zh": "kHz，17"}, {"s": 327.32, "e": 333.91, "zh": "kHz，18 kHz"}, {"s": 333.92, "e": 339.39, "zh": "19"}, {"s": 339.4, "e": 348.75, "zh": "kHz，20"}, {"s": 348.76, "e": 351.39, "zh": "kHz。欢迎来到人类"}, {"s": 351.4, "e": 354.03, "zh": "听觉的上限。输出波形仍然"}, {"s": 354.04, "e": 357.31, "zh": "完美，没有锯齿边缘，没有衰减，没有"}, {"s": 357.32, "e": 358.23, "zh": "阶梯"}, {"s": 358.24, "e": 362.07, "zh": "台阶。那么阶梯台阶去哪了？别"}, {"s": 362.08, "e": 363.59, "zh": "回答，这是个陷阱题，它们"}, {"s": 363.6, "e": 365.75, "zh": "从来就不存在。把数字波形画成"}, {"s": 365.76, "e": 368.11, "zh": "阶梯"}, {"s": 368.12, "e": 372.47, "zh": "台阶，一开始就错了。为什么"}, {"s": 372.48, "e": 374.59, "zh": "阶梯波形是连续时间函数"}, {"s": 374.6, "e": 376.87, "zh": "它有锯齿、是分段式的，但"}, {"s": 376.88, "e": 379.07, "zh": "在每个点都有定义值，在"}, {"s": 379.08, "e": 381.75, "zh": "时间上，采样信号完全"}, {"s": 381.76, "e": 384.39, "zh": "不同。它是离散时间，它只有"}, {"s": 384.4, "e": 386.79, "zh": "在每个瞬时"}, {"s": 386.8, "e": 389.11, "zh": "采样点才有值，而它未定义，"}, {"s": 389.12, "e": 392.63, "zh": "中间任何地方都没有值。一个"}, {"s": 392.64, "e": 394.91, "zh": "离散时间信号应该正确地画成"}, {"s": 394.92, "e": 399.11, "zh": "棒棒糖"}, {"s": 399.12, "e": 401.91, "zh": "图。数字信号的连续模拟"}, {"s": 401.92, "e": 404.23, "zh": "对应物平滑地"}, {"s": 404.24, "e": 406.07, "zh": "穿过每个采样点，而且这"}, {"s": 406.08, "e": 408.47, "zh": "对高频来说同样成立，就像它"}, {"s": 408.48, "e": 411.71, "zh": "对低频一样。现在有趣且"}, {"s": 411.72, "e": 414.11, "zh": "完全不明显的一点是，只有一个"}, {"s": 414.12, "e": 416.39, "zh": "带限信号，恰好"}, {"s": 416.4, "e": 418.27, "zh": "通过每个采样点，它是唯一的"}, {"s": 418.28, "e": 420.75, "zh": "解，所以如果你对一个带"}, {"s": 420.76, "e": 422.99, "zh": "限信号采样，再把它转换回来"}, {"s": 423.0, "e": 425.51, "zh": "原始输入也是唯一"}, {"s": 425.52, "e": 428.23, "zh": "可能的输出。在你说“哦，我"}, {"s": 428.24, "e": 429.91, "zh": "可以画出另一条通过"}, {"s": 429.92, "e": 436.43, "zh": "那些点的信号”之前——是的，你可以"}, {"s": 436.44, "e": 440.31, "zh": "但如果它与原始信号有丝毫不同"}, {"s": 440.32, "e": 442.95, "zh": "它就包含频率成分"}, {"s": 442.96, "e": 445.39, "zh": "位于或超过 Nyquist，就会破坏带"}, {"s": 445.4, "e": 447.67, "zh": "限要求，而且不是一个有效"}, {"s": 447.68, "e": 449.79, "zh": "解。那大家怎么会"}, {"s": 449.8, "e": 451.43, "zh": "困惑，开始把数字"}, {"s": 451.44, "e": 453.87, "zh": "信号想成阶梯？我能想到两个"}, {"s": 453.88, "e": 456.43, "zh": "好理由。第一，很容易"}, {"s": 456.44, "e": 458.43, "zh": "把采样信号转换成真正的阶梯"}, {"s": 458.44, "e": 460.63, "zh": "只需把每个采样值"}, {"s": 460.64, "e": 462.75, "zh": "向前延伸，直到下一个采样周期"}, {"s": 462.76, "e": 464.79, "zh": "这叫零阶保持，而且"}, {"s": 464.8, "e": 466.27, "zh": "它是某些"}, {"s": 466.28, "e": 468.43, "zh": "数模转换器工作方式的重要组成部分"}, {"s": 468.44, "e": 471.19, "zh": "尤其是最简单的那些。所以任何人"}, {"s": 471.2, "e": 473.47, "zh": "查数模转换器"}, {"s": 473.48, "e": 475.87, "zh": "或数模转换，就会"}, {"s": 475.88, "e": 477.79, "zh": "很可能看到一张"}, {"s": 477.8, "e": 480.59, "zh": "阶梯波形的示意图，但那"}, {"s": 480.6, "e": 482.99, "zh": "不是完成的转换，也不是"}, {"s": 483.0, "e": 485.87, "zh": "最终输出的信号。第二"}, {"s": 485.88, "e": 487.95, "zh": "这大概是更可能的原因"}, {"s": 487.96, "e": 489.83, "zh": "那些本该更懂的工程师"}, {"s": 489.84, "e": 492.15, "zh": "比如我，会画阶梯，尽管"}, {"s": 492.16, "e": 494.07, "zh": "技术上并不正确。这有点像"}, {"s": 494.08, "e": 496.03, "zh": "fat 的一维版本"}, {"s": 496.04, "e": 498.43, "zh": "图像编辑器里的位，像素也不是"}, {"s": 498.44, "e": 500.59, "zh": "方块，而是某个"}, {"s": 500.6, "e": 502.59, "zh": "二维函数空间的采样，因此"}, {"s": 502.6, "e": 504.99, "zh": "它们在概念上也是无限"}, {"s": 505.0, "e": 507.63, "zh": "小的点，但实际中这真是"}, {"s": 507.64, "e": 509.51, "zh": "要看见或操纵它，简直折磨死人"}, {"s": 509.52, "e": 511.71, "zh": "无限小的东西，所以就用大方块"}, {"s": 511.72, "e": 514.47, "zh": "数字图像也一样，阶梯状画法"}, {"s": 514.48, "e": 516.95, "zh": "完全是一回事，它只是"}, {"s": 516.96, "e": 518.91, "zh": "一种方便的绘制方式，那些阶梯"}, {"s": 518.92, "e": 524.99, "zh": "并不真正"}, {"s": 525.0, "e": 527.55, "zh": "存在。当我们把数字信号"}, {"s": 527.56, "e": 529.99, "zh": "转回模拟信号时，结果也是平滑的"}, {"s": 530.0, "e": 532.83, "zh": "不管位深是 24 位还是 16"}, {"s": 532.84, "e": 536.03, "zh": "位或 8 位，都无所谓。那么"}, {"s": 536.04, "e": 537.35, "zh": "这是否意味着数字位"}, {"s": 537.36, "e": 539.67, "zh": "深完全没区别？当"}, {"s": 539.68, "e": 541.19, "zh": "然"}, {"s": 541.2, "e": 544.87, "zh": "不是。这里的通道 2 是同样的正弦波"}, {"s": 544.88, "e": 547.95, "zh": "输入，但我们用抖动把它量化到"}, {"s": 547.96, "e": 552.43, "zh": "8 位。在示波器上，我们仍能看到漂亮"}, {"s": 552.44, "e": 555.39, "zh": "平滑的正弦波在通道 2 上，看起来非常"}, {"s": 555.4, "e": 557.43, "zh": "接近，你还会看到多了一点"}, {"s": 557.44, "e": 560.43, "zh": "噪声。这是个线索：如果我们看"}, {"s": 560.44, "e": 562.19, "zh": "频谱，那个"}, {"s": 562.2, "e": 565.59, "zh": "信号，啊哈，我们的正弦波还在"}, {"s": 565.6, "e": 567.71, "zh": "未受影响，但噪声电平"}, {"s": 567.72, "e": 570.99, "zh": "在第二通道的 8 位信号上"}, {"s": 571.0, "e": 572.51, "zh": "要"}, {"s": 572.52, "e": 575.15, "zh": "高得多，这就是区别："}, {"s": 575.16, "e": 578.03, "zh": "位数造成的。就这样。当我们"}, {"s": 578.04, "e": 580.27, "zh": "数字化一个信号时，首先采样，采样"}, {"s": 580.28, "e": 582.07, "zh": "步骤是完美的，它不丢失"}, {"s": 582.08, "e": 584.35, "zh": "任何东西，但随后量化它，而"}, {"s": 584.36, "e": 587.03, "zh": "量化会添加"}, {"s": 587.04, "e": 589.75, "zh": "噪声。位数决定"}, {"s": 589.76, "e": 591.95, "zh": "噪声有多少，也就是噪声"}, {"s": 591.96, "e": 600.59, "zh": "底的电平"}, {"s": 600.6, "e": 602.19, "zh": "这种抖动量化到底是什么？"}, {"s": 602.2, "e": 604.39, "zh": "噪声听起来像，让我们听听我们的"}, {"s": 604.4, "e": 611.79, "zh": "8 位正弦"}, {"s": 611.8, "e": 614.15, "zh": "波，可能刚才很难听清"}, {"s": 614.16, "e": 616.35, "zh": "除了那个音调，让我们听听"}, {"s": 616.36, "e": 618.31, "zh": "只留下噪声，等我们用陷波滤除"}, {"s": 618.32, "e": 620.11, "zh": "正弦波，然后把增益调高"}, {"s": 620.12, "e": 632.71, "zh": "一点，因为噪声很轻"}, {"s": 632.72, "e": 634.39, "zh": "用过模拟"}, {"s": 634.4, "e": 635.91, "zh": "录音设备的人可能刚刚"}, {"s": 635.92, "e": 638.87, "zh": "心里想，天哪，这"}, {"s": 638.88, "e": 640.91, "zh": "听起来像磁带嘶声；嗯，它不只是"}, {"s": 640.92, "e": 642.91, "zh": "听起来像磁带嘶声，表现也像"}, {"s": 642.92, "e": 645.31, "zh": "磁带嘶声；如果我们用高斯抖动"}, {"s": 645.32, "e": 646.95, "zh": "那它在数学上完全等价"}, {"s": 646.96, "e": 650.51, "zh": "方方面面，直觉上它就是磁带嘶声"}, {"s": 650.52, "e": 652.07, "zh": "这意味着我们可以测量磁带嘶声"}, {"s": 652.08, "e": 653.75, "zh": "进而测量磁"}, {"s": 653.76, "e": 656.75, "zh": "带音频的本底噪声，用比特而不是 dB，来"}, {"s": 656.76, "e": 658.63, "zh": "把问题放到数字"}, {"s": 658.64, "e": 659.83, "zh": "视角下"}, {"s": 659.84, "e": 662.39, "zh": "紧凑"}, {"s": 662.4, "e": 664.71, "zh": "盒式磁带；你们中年纪够大"}, {"s": 664.72, "e": 666.31, "zh": "还记得它们的人知道，完美条件下它能达到"}, {"s": 666.32, "e": 669.35, "zh": "深达 9 比特"}, {"s": 669.36, "e": 671.51, "zh": "不过 5 到 6 比特更典型"}, {"s": 671.52, "e": 673.11, "zh": "尤其是录音来自"}, {"s": 673.12, "e": 675.75, "zh": "磁带机；没错，你的混音带"}, {"s": 675.76, "e": 679.19, "zh": "只有大约 6 比特深，如果你"}, {"s": 679.2, "e": 681.71, "zh": "运气好；录音棚里最好的专业开盘"}, {"s": 681.72, "e": 684.15, "zh": "式磁带也几乎只能"}, {"s": 684.16, "e": 688.23, "zh": "达到——猜猜看——13 比特，配合高级"}, {"s": 688.24, "e": 690.31, "zh": "降噪；这就是为什么看到"}, {"s": 690.32, "e": 693.59, "zh": "CD 上的 DDD 曾经是那么"}, {"s": 693.6, "e": 697.29, "zh": "高端"}, {"s": 699.64, "e": 702.35, "zh": "的大事；我一直说我在量化"}, {"s": 702.36, "e": 704.75, "zh": "时使用抖动，那么抖动到底是什么"}, {"s": 704.76, "e": 707.99, "zh": "更重要的是，它到底有什么作用"}, {"s": 708.0, "e": 709.87, "zh": "量化信号的简单方法是"}, {"s": 709.88, "e": 711.99, "zh": "选择数字幅度值"}, {"s": 712.0, "e": 714.59, "zh": "最接近原始模拟幅度"}, {"s": 714.6, "e": 717.19, "zh": "显然没错，但不幸的是，具体的"}, {"s": 717.2, "e": 718.43, "zh": "你从这种简单"}, {"s": 718.44, "e": 721.07, "zh": "量化方案得到的噪声，在某种程度上取决于"}, {"s": 721.08, "e": 723.71, "zh": "输入信号，所以我们可能得到"}, {"s": 723.72, "e": 726.63, "zh": "不一致的噪声，或造成失真"}, {"s": 726.64, "e": 729.51, "zh": "或以其他方式令人不满意"}, {"s": 729.52, "e": 731.79, "zh": "抖动是专门构造的噪声"}, {"s": 731.8, "e": 733.71, "zh": "用来替代所产生的噪声"}, {"s": 733.72, "e": 735.91, "zh": "由简单量化产生；抖动不会"}, {"s": 735.92, "e": 738.83, "zh": "淹没或掩盖量化噪声，它"}, {"s": 738.84, "e": 740.99, "zh": "实际上会用噪声替换它"}, {"s": 741.0, "e": 743.03, "zh": "具有我们选择的特性，这些特性"}, {"s": 743.04, "e": 745.75, "zh": "不受输入影响。让我们"}, {"s": 745.76, "e": 748.15, "zh": "看看抖动做了什么。信号"}, {"s": 748.16, "e": 749.83, "zh": "发生器噪声太大，不适合这个"}, {"s": 749.84, "e": 752.83, "zh": "测试，所以我们会在"}, {"s": 752.84, "e": 754.91, "zh": "ThinkPad 上生成数学上完美的正弦波，并"}, {"s": 754.92, "e": 757.83, "zh": "把它量化为 8 位，并"}, {"s": 757.84, "e": 760.27, "zh": "进行抖动。我们在"}, {"s": 760.28, "e": 765.75, "zh": "波形显示和输出示波器上看到漂亮的正弦波"}, {"s": 765.76, "e": 768.43, "zh": "一旦模拟频谱分析仪"}, {"s": 768.44, "e": 769.67, "zh": "跟上，"}, {"s": 769.68, "e": 772.91, "zh": "就会出现干净的频率峰，带有均匀的"}, {"s": 772.92, "e": 775.91, "zh": "噪声"}, {"s": 775.92, "e": 778.75, "zh": "底，在两个频谱显示上，就像"}, {"s": 778.76, "e": 783.15, "zh": "之前一样。再说一次，这是开启抖动。现在我"}, {"s": 783.16, "e": 784.83, "zh": "把抖动"}, {"s": 784.84, "e": 787.59, "zh": "关掉。原本被抖动"}, {"s": 787.6, "e": 789.99, "zh": "铺平成漂亮平坦噪声底的量化噪声"}, {"s": 790.0, "e": 792.23, "zh": "会堆积成谐波失真峰"}, {"s": 792.24, "e": 794.27, "zh": "噪声底更低，但"}, {"s": 794.28, "e": 796.63, "zh": "失真电平变为非零，而且"}, {"s": 796.64, "e": 798.39, "zh": "失真峰比"}, {"s": 798.4, "e": 800.95, "zh": "8 位时的抖动噪声更高。这"}, {"s": 800.96, "e": 803.67, "zh": "这种效应在 16"}, {"s": 803.68, "e": 806.47, "zh": "比特时会被夸大，即使没有抖动，谐波"}, {"s": 806.48, "e": 808.83, "zh": "失真也会低到"}, {"s": 808.84, "e": 811.91, "zh": "完全听不见，但我们仍可以用"}, {"s": 811.92, "e": 814.23, "zh": "抖动来消除它"}, {"s": 814.24, "e": 816.51, "zh": "完全消除，如果我们愿意"}, {"s": 816.52, "e": 818.79, "zh": "选择再次关闭抖动，持续"}, {"s": 818.8, "e": 819.91, "zh": "一"}, {"s": 819.92, "e": 822.35, "zh": "小会儿，你会注意到，绝对的"}, {"s": 822.36, "e": 823.91, "zh": "来自未抖动"}, {"s": 823.92, "e": 826.63, "zh": "量化的失真水平大致保持"}, {"s": 826.64, "e": 828.07, "zh": "不变，无论输入"}, {"s": 828.08, "e": 830.03, "zh": "幅度如何；但当信号电平"}, {"s": 830.04, "e": 832.35, "zh": "降到半个比特以下，所有东西"}, {"s": 832.36, "e": 835.19, "zh": "都量化为零；某种意义上，所有东西"}, {"s": 835.2, "e": 838.03, "zh": "量化为零就是 100%"}, {"s": 838.04, "e": 840.27, "zh": "失真。抖动可以消除这种"}, {"s": 840.28, "e": 843.67, "zh": "失真。我们重新启用抖动，"}, {"s": 843.68, "e": 847.07, "zh": "信号回来了，在 1/4 比特，带着"}, {"s": 847.08, "e": 848.63, "zh": "我们漂亮平坦的噪声"}, {"s": 848.64, "e": 850.91, "zh": "底。噪声底不必是"}, {"s": 850.92, "e": 853.19, "zh": "平坦的；抖动是我们选择的噪声，所以"}, {"s": 853.2, "e": 855.71, "zh": "让我们选一种尽可能不刺耳、"}, {"s": 855.72, "e": 857.11, "zh": "难以察觉的"}, {"s": 857.12, "e": 859.59, "zh": "噪声。我们的听觉最敏感"}, {"s": 859.6, "e": 862.91, "zh": "在中频段，2 kHz 到 4 kHz，所以"}, {"s": 862.92, "e": 864.27, "zh": "那里背景噪声会"}, {"s": 864.28, "e": 866.55, "zh": "最明显。我们可以对"}, {"s": 866.56, "e": 868.59, "zh": "抖动噪声进行整形，避开敏感"}, {"s": 868.6, "e": 870.63, "zh": "频率，移到听觉较不"}, {"s": 870.64, "e": 873.23, "zh": "敏感的地方，通常是最高"}, {"s": 873.24, "e": 875.67, "zh": "频率。16 位抖动噪声"}, {"s": 875.68, "e": 877.59, "zh": "通常太轻，根本听不到"}, {"s": 877.6, "e": 879.35, "zh": "但让我们听听噪声整形"}, {"s": 879.36, "e": 895.23, "zh": "示例，把增益调得"}, {"s": 895.24, "e": 898.71, "zh": "很高。最后，抖动量化噪声"}, {"s": 898.72, "e": 900.91, "zh": "总功率高于未抖动"}, {"s": 900.92, "e": 903.55, "zh": "量化噪声，即使听起来"}, {"s": 903.56, "e": 905.75, "zh": "更安静，你可以在 VU 表上看到"}, {"s": 905.76, "e": 907.99, "zh": "在接近静音的段落里"}, {"s": 908.0, "e": 910.03, "zh": "抖动不只是开或关"}, {"s": 910.04, "e": 912.83, "zh": "的选择，我们可以降低抖动强度来"}, {"s": 912.84, "e": 915.23, "zh": "在更少噪声和一点"}, {"s": 915.24, "e": 918.67, "zh": "失真之间权衡，以尽量减小整体"}, {"s": 918.68, "e": 921.27, "zh": "影响。我们还会调制输入"}, {"s": 921.28, "e": 926.11, "zh": "信号，像"}, {"s": 926.12, "e": 928.75, "zh": "这样，来展示变化的输入如何影响"}, {"s": 928.76, "e": 930.99, "zh": "量化噪声。在满抖动"}, {"s": 931.0, "e": 933.43, "zh": "强度下，噪声是均匀、恒定且"}, {"s": 933.44, "e": 940.31, "zh": "无特征的，正如我们"}, {"s": 940.32, "e": 943.35, "zh": "所预期。随着我们降低抖动强度，"}, {"s": 943.36, "e": 945.95, "zh": "输入会越来越影响幅度"}, {"s": 945.96, "e": 947.59, "zh": "以及量化"}, {"s": 947.6, "e": 970.07, "zh": "噪声的特征"}, {"s": 970.08, "e": 971.43, "zh": "整形"}, {"s": 971.44, "e": 974.43, "zh": "抖动表现类似，但噪声"}, {"s": 974.44, "e": 976.87, "zh": "整形还带来一个额外的好处，让"}, {"s": 976.88, "e": 979.07, "zh": "长话短说，它能使用"}, {"s": 979.08, "e": 980.79, "zh": "稍低一些的抖动强度，在输入"}, {"s": 980.8, "e": 1009.27, "zh": "对输出产生同样大影响之前"}, {"s": 1009.28, "e": 1011.27, "zh": "尽管我刚花了这么多时间在"}, {"s": 1011.28, "e": 1013.27, "zh": "抖动上，我们讨论的差异"}, {"s": 1013.28, "e": 1015.75, "zh": "从低于满刻度 100 dB 甚至更多开始"}, {"s": 1015.76, "e": 1018.71, "zh": "也许如果 CD 当初是 14 位"}, {"s": 1018.72, "e": 1020.83, "zh": "按最初设计，抖动可能"}, {"s": 1020.84, "e": 1024.31, "zh": "更重要；但也许在 16 位时，其实"}, {"s": 1024.32, "e": 1026.47, "zh": "基本没什么差别。你可以把"}, {"s": 1026.48, "e": 1029.15, "zh": "抖动看作一份保险单，它能带来"}, {"s": 1029.16, "e": 1032.03, "zh": "几个额外的 dB 动态范围，以防"}, {"s": 1032.04, "e": 1035.11, "zh": "万一。但简单的事实是，没人"}, {"s": 1035.12, "e": 1037.15, "zh": "曾因为没"}, {"s": 1037.16, "e": 1039.95, "zh": "给最终"}, {"s": 1043.52, "e": 1046.03, "zh": "母带做抖动而毁掉一次伟大的录音。我们一直用正弦波"}, {"s": 1046.04, "e": 1047.75, "zh": "它们显然是首选，当我们要看的是"}, {"s": 1047.76, "e": 1050.07, "zh": "系统在某个水平下的行为"}, {"s": 1050.08, "e": 1052.63, "zh": "给定孤立频率后，现在让我们看看"}, {"s": 1052.64, "e": 1054.75, "zh": "稍微复杂一点的情况：如果"}, {"s": 1054.76, "e": 1056.79, "zh": "我改变输入，应该"}, {"s": 1056.8, "e": 1061.71, "zh": "会发生什么"}, {"s": 1061.72, "e": 1065.15, "zh": "把输入改成方波？输入示波器确认我们的 1 kHz"}, {"s": 1065.16, "e": 1068.11, "zh": "方波。输出示波器"}, {"s": 1068.12, "e": 1070.51, "zh": "显示的正是它"}, {"s": 1070.52, "e": 1075.03, "zh": "应该的样子。方波到底是什么？其实"}, {"s": 1075.04, "e": 1077.39, "zh": "我们可以说，它是一种波形，它是某个"}, {"s": 1077.4, "e": 1079.51, "zh": "在半个周期内为正的值，然后"}, {"s": 1079.52, "e": 1081.39, "zh": "瞬间跳变到"}, {"s": 1081.4, "e": 1083.39, "zh": "另一半周期的负值，但"}, {"s": 1083.4, "e": 1084.79, "zh": "这并没有真正告诉我们任何"}, {"s": 1084.8, "e": 1089.55, "zh": "关于这个输入如何变成这个"}, {"s": 1089.56, "e": 1092.43, "zh": "输出的有用信息。然后我们记得，任何"}, {"s": 1092.44, "e": 1094.91, "zh": "波形也都是离散"}, {"s": 1094.92, "e": 1096.83, "zh": "频率之和，而方波是"}, {"s": 1096.84, "e": 1099.63, "zh": "一种特别简单的和：一个基频"}, {"s": 1099.64, "e": 1102.23, "zh": "加上无限系列的奇次谐波"}, {"s": 1102.24, "e": 1105.63, "zh": "把它们全加起来，你就得到方"}, {"s": 1105.64, "e": 1108.23, "zh": "波。乍看之下，这似乎"}, {"s": 1108.24, "e": 1110.55, "zh": "也不太有用：你必须把"}, {"s": 1110.56, "e": 1112.39, "zh": "无限多个谐波加起来才能得到"}, {"s": 1112.4, "e": 1114.91, "zh": "答案。啊，但我们并没有无限"}, {"s": 1114.92, "e": 1116.15, "zh": "多个"}, {"s": 1116.16, "e": 1118.79, "zh": "谐波。我们使用了一个相当陡峭的"}, {"s": 1118.8, "e": 1121.11, "zh": "抗混叠滤波器，它正好在"}, {"s": 1121.12, "e": 1123.59, "zh": "20 kHz 以上截止，所以我们的信号是带"}, {"s": 1123.6, "e": 1131.75, "zh": "限的，这意味着我们会得到"}, {"s": 1131.76, "e": 1134.91, "zh": "这个。而这正是我们在"}, {"s": 1134.92, "e": 1137.39, "zh": "输出示波器上看到的。你看到的纹波"}, {"s": 1137.4, "e": 1139.27, "zh": "出现在带限"}, {"s": 1139.28, "e": 1141.35, "zh": "信号的陡峭边缘附近，叫做吉布斯效应。它"}, {"s": 1141.36, "e": 1143.35, "zh": "会在你切掉一部分"}, {"s": 1143.36, "e": 1145.19, "zh": "频域，而且切在"}, {"s": 1145.2, "e": 1148.47, "zh": "非零能量的中间时发生。通常的经验法则"}, {"s": 1148.48, "e": 1150.23, "zh": "你会听到的是：截止越陡峭"}, {"s": 1150.24, "e": 1151.75, "zh": "波纹就越强，这"}, {"s": 1151.76, "e": 1153.47, "zh": "大致是对的，但我们必须"}, {"s": 1153.48, "e": 1155.27, "zh": "仔细想想该怎么理解它，举个"}, {"s": 1155.28, "e": 1158.07, "zh": "例子：你会期望我们那个相当"}, {"s": 1158.08, "e": 1160.59, "zh": "陡峭的抗混叠滤波器做什么，如果我"}, {"s": 1160.6, "e": 1174.59, "zh": "把信号再通过它一次"}, {"s": 1174.6, "e": 1176.23, "zh": "除了增加几个几分之一"}, {"s": 1176.24, "e": 1179.03, "zh": "周期的延迟，答案是"}, {"s": 1179.04, "e": 1182.59, "zh": "什么也没有，信号已经"}, {"s": 1182.6, "e": 1185.39, "zh": "是带限的，再次带限它"}, {"s": 1185.4, "e": 1188.03, "zh": "不会有任何作用，第二遍不能"}, {"s": 1188.04, "e": 1191.23, "zh": "移除我们已经"}, {"s": 1191.24, "e": 1194.11, "zh": "移除的频率，这很重要，人们往往"}, {"s": 1194.12, "e": 1195.75, "zh": "把波纹看成一种"}, {"s": 1195.76, "e": 1198.47, "zh": "由抗混叠"}, {"s": 1198.48, "e": 1200.87, "zh": "和抗镜像滤波器添加的伪影，暗示"}, {"s": 1200.88, "e": 1202.67, "zh": "波纹都会变得更糟，每次"}, {"s": 1202.68, "e": 1204.95, "zh": "信号通过时，我们在这个"}, {"s": 1204.96, "e": 1207.15, "zh": "情况里并没有发生，所以真的是"}, {"s": 1207.16, "e": 1208.83, "zh": "是滤波器添加了波纹吗，第一次"}, {"s": 1208.84, "e": 1211.19, "zh": "通过时？不，并非如此，这是一个"}, {"s": 1211.2, "e": 1213.27, "zh": "微妙的区别，但 Gibbs 效应"}, {"s": 1213.28, "e": 1215.71, "zh": "波纹不是由滤波器添加的，它们"}, {"s": 1215.72, "e": 1218.07, "zh": "只是带限信号"}, {"s": 1218.08, "e": 1221.11, "zh": "的一部分，即使我们合成构造"}, {"s": 1221.12, "e": 1223.35, "zh": "看起来像完美的数字方"}, {"s": 1223.36, "e": 1225.75, "zh": "波，它仍然受限于通道"}, {"s": 1225.76, "e": 1227.55, "zh": "带宽，记住阶梯"}, {"s": 1227.56, "e": 1229.27, "zh": "表示会误导人"}, {"s": 1229.28, "e": 1230.99, "zh": "我们这里真正拥有的是"}, {"s": 1231.0, "e": 1233.63, "zh": "瞬时采样点，并且只有一个"}, {"s": 1233.64, "e": 1236.31, "zh": "带限信号能拟合这些点"}, {"s": 1236.32, "e": 1238.75, "zh": "我们画那个看似"}, {"s": 1238.76, "e": 1241.23, "zh": "完美方波时所做的，只是对齐"}, {"s": 1241.24, "e": 1244.63, "zh": "采样点选得刚刚好，所以看起来"}, {"s": 1244.64, "e": 1246.39, "zh": "播放时没有波纹"}, {"s": 1246.4, "e": 1248.75, "zh": "连点成线，但原始带"}, {"s": 1248.76, "e": 1251.15, "zh": "限信号连同波纹仍然"}, {"s": 1251.16, "e": 1253.03, "zh": "仍然"}, {"s": 1253.04, "e": 1255.47, "zh": "存在，这引出了另一个"}, {"s": 1255.48, "e": 1257.75, "zh": "重要观点，你可能听过"}, {"s": 1257.76, "e": 1259.07, "zh": "也就是，一个"}, {"s": 1259.08, "e": 1261.35, "zh": "数字信号的时序精度受其采样"}, {"s": 1261.36, "e": 1263.51, "zh": "率限制。换句话说，数字"}, {"s": 1263.52, "e": 1265.47, "zh": "信号无法表示任何"}, {"s": 1265.48, "e": 1269.15, "zh": "落在采样点之间的东西，这意味着"}, {"s": 1269.16, "e": 1271.79, "zh": "脉冲或快速起音必须对齐"}, {"s": 1271.8, "e": 1274.07, "zh": "正好落在某个采样点，否则时序会"}, {"s": 1274.08, "e": 1277.23, "zh": "被弄乱，或者干脆消失。到这一步"}, {"s": 1277.24, "e": 1281.03, "zh": "我们很容易看出为什么这是错的"}, {"s": 1281.04, "e": 1284.43, "zh": "再说一次，我们的输入信号是带限的"}, {"s": 1284.44, "e": 1286.71, "zh": "数字信号是采样点，不是"}, {"s": 1286.72, "e": 1290.31, "zh": "阶梯，也不是连起来的"}, {"s": 1290.32, "e": 1295.71, "zh": "点。我们当然可以，比如"}, {"s": 1295.72, "e": 1298.19, "zh": "把带限方波的上升沿"}, {"s": 1298.2, "e": 1300.55, "zh": "放在我们想要的任何位置"}, {"s": 1300.56, "e": 1306.75, "zh": "在采样点之间，它被表示得"}, {"s": 1306.76, "e": 1308.99, "zh": "完美，也被重建得"}, {"s": 1309.0, "e": 1317.02, "zh": "完美"}, {"s": 1325.2, "e": 1326.95, "zh": "就像上一集，我们"}, {"s": 1326.96, "e": 1329.07, "zh": "涵盖了很多话题，却"}, {"s": 1329.08, "e": 1331.23, "zh": "每个都只是浅尝辄止"}, {"s": 1331.24, "e": 1332.63, "zh": "要说的话，我的遗漏"}, {"s": 1332.64, "e": 1334.75, "zh": "这次更多，但这是一个"}, {"s": 1334.76, "e": 1336.99, "zh": "不错的停顿点，或者也许是个不错的"}, {"s": 1337.0, "e": 1339.79, "zh": "起点。深入实验吧。我"}, {"s": 1339.8, "e": 1342.03, "zh": "选择演示时非常仔细，让它们"}, {"s": 1342.04, "e": 1344.19, "zh": "简单并给出清晰结果，你可以"}, {"s": 1344.2, "e": 1345.71, "zh": "自己复现每一个"}, {"s": 1345.72, "e": 1348.23, "zh": "如果你愿意，但说实话，有时候"}, {"s": 1348.24, "e": 1350.11, "zh": "要最深入地了解一个精巧玩具，就得"}, {"s": 1350.12, "e": 1351.59, "zh": "把它拆开，研究所有"}, {"s": 1351.6, "e": 1353.87, "zh": "掉出来的零件，这没关系"}, {"s": 1353.88, "e": 1356.07, "zh": "我们工程师会摆弄演示"}, {"s": 1356.08, "e": 1358.39, "zh": "参数，改代码，搭建"}, {"s": 1358.4, "e": 1360.19, "zh": "替代实验。所有东西的源代码"}, {"s": 1360.2, "e": 1361.79, "zh": "包括那个小小的按钮"}, {"s": 1361.8, "e": 1363.99, "zh": "演示应用，都在 z.org 上"}, {"s": 1364.0, "e": 1366.55, "zh": "在实验过程中，你"}, {"s": 1366.56, "e": 1368.23, "zh": "很可能会遇到一些你"}, {"s": 1368.24, "e": 1370.75, "zh": "没预料到、也解释不了的东西。别"}, {"s": 1370.76, "e": 1373.03, "zh": "担心，撇开我之前的刻薄话，维基百科"}, {"s": 1373.04, "e": 1375.71, "zh": "对这类"}, {"s": 1375.72, "e": 1377.99, "zh": "随意研究再合适不过。如果你真的"}, {"s": 1378.0, "e": 1379.95, "zh": "想认真理解信号"}, {"s": 1379.96, "e": 1381.47, "zh": "好几所大学都有高级"}, {"s": 1381.48, "e": 1386.11, "zh": "材料在线，比如 63 和 67"}, {"s": 1386.12, "e": 1388.19, "zh": "信号与系统模块，在 MIT Open"}, {"s": 1388.2, "e": 1390.03, "zh": "Courseware 上。当然，也一直有"}, {"s": 1390.04, "e": 1392.35, "zh": "z.org 这里的社区"}, {"s": 1392.36, "e": 1395.11, "zh": "要不要深入挖掘都行，我咖啡喝完了"}, {"s": 1395.12, "e": 1398.67, "zh": "所以下次见，祝"}, {"s": 1398.68, "e": 1401.51, "zh": "黑客愉快。就这样"}, {"s": 1401.52, "e": 1405.03, "zh": "我已经说过了"}, {"s": 1405.04, "e": 1409.55, "zh": "一切。这说不通，今天"}, {"s": 1409.56, "e": 1418.75, "zh": "这一切听起来都特别奇怪"}]}