{"vid": "Fpu5a0Bl8eY", "model": "deepseek-v4.1-flash+cn:deepseek-v4.1-flash+global:deepseek-v4.1-flash-sg", "source": "Fpu5a0Bl8eY.en.vtt", "cues": [{"s": 6.1, "e": 8.88, "zh": "你是否有空听我说", "en": "Have you got some time for me"}, {"s": 9.38, "e": 11.89, "zh": "那让我为你唱首歌", "en": "Then let me sing a song for you"}, {"s": 12.0, "e": 15.13, "zh": "关于99个气球", "en": "About 99 balloons"}, {"s": 15.79, "e": 18.72, "zh": "飘向地平线", "en": "On their way to the horizon"}, {"s": 19.2, "e": 22.21, "zh": "也许你此刻正想着我", "en": "Perhaps you're thinking about me right now"}, {"s": 22.47, "e": 25.36, "zh": "那让我为你唱首歌", "en": "Then let me sing a song for you"}, {"s": 25.51, "e": 28.44, "zh": "关于99个气球", "en": "About 99 balloons"}, {"s": 29.2, "e": 32.24, "zh": "以及事情如何一环扣一环", "en": "And how one thing leads to another"}, {"s": 73.85, "e": 76.31, "zh": "99个气球", "en": "99 balloons"}, {"s": 76.54, "e": 78.77, "zh": "飘向地平线", "en": "On their way to the horizon"}, {"s": 78.77, "e": 81.22, "zh": "人们以为那是来自太空的UFO", "en": "Which people thought were UFOs from space"}, {"s": 81.42, "e": 83.73, "zh": "于是将军派出了", "en": "That's why a general sent"}, {"s": 83.87, "e": 86.13, "zh": "一支战斗机中队去追击", "en": "A fighter squadron after them"}, {"s": 86.41, "e": 88.86, "zh": "以防万一拉响警报", "en": "To raise the alarm just in case they were"}, {"s": 88.86, "e": 91.25, "zh": "它们就在地平线上", "en": "There they were on the horizon"}, {"s": 91.32, "e": 94.16, "zh": "不过是99个气球", "en": "Just 99 balloons"}, {"s": 104.26, "e": 106.47, "zh": "99名战斗机飞行员", "en": "99 fighter jet pilots"}, {"s": 106.56, "e": 108.85, "zh": "个个都是骁勇战士", "en": "Each one of them a great warrior"}, {"s": 109.11, "e": 111.4, "zh": "自以为是Captain Kirk", "en": "Reckoned they were Captain Kirk"}, {"s": 111.57, "e": 114.11, "zh": "上演了一场盛大的烟火秀", "en": "There was a great fireworks display"}, {"s": 114.3, "e": 116.88, "zh": "邻居们完全摸不着头脑", "en": "The neighbours didn’t get it at all"}, {"s": 116.88, "e": 119.21, "zh": "突然觉得自己遭到了攻击", "en": "And suddenly felt under attack"}, {"s": 119.21, "e": 121.71, "zh": "于是朝地平线开火", "en": "So they shot at the horizon"}, {"s": 121.78, "e": 124.13, "zh": "射向那99个气球", "en": "At the 99 balloons"}, {"s": 154.81, "e": 156.75, "zh": "99位战争部长", "en": "99 Ministers of War"}, {"s": 156.93, "e": 159.32, "zh": "火柴和汽油桶", "en": "Matchstick and petrol cans"}, {"s": 159.7, "e": 162.19, "zh": "自以为是聪明人", "en": "Thought they were smart people"}, {"s": 162.41, "e": 164.73, "zh": "嗅到了大奖的味道", "en": "Sensed a big prize"}, {"s": 164.83, "e": 167.3, "zh": "叫嚣战争，渴求权力", "en": "Called for war and wanted power"}, {"s": 167.3, "e": 169.57, "zh": "天哪，谁能想到", "en": "Man, who would’ve thought"}, {"s": 169.72, "e": 172.13, "zh": "事情竟会发展到这一步", "en": "That it could come to this"}, {"s": 172.21, "e": 174.46, "zh": "就因为99个气球", "en": "because of 99 balloons"}, {"s": 177.23, "e": 179.81, "zh": "就因为99个气球", "en": "because of 99 balloons"}, {"s": 187.45, "e": 189.94, "zh": "99个气球", "en": "99 balloons"}, {"s": 198.77, "e": 201.35, "zh": "99年的战争", "en": "99 years of war"}, {"s": 201.61, "e": 204.75, "zh": "没给赢家留任何余地", "en": "Leave no room for winners"}, {"s": 204.94, "e": 207.94, "zh": "再也没有战争部长了", "en": "There aren’t any more War Ministers"}, {"s": 208.5, "e": 211.52, "zh": "也没有战斗机飞行员了", "en": "And no more fighter jet pilots"}, {"s": 211.69, "e": 215.18, "zh": "今天我走在街上", "en": "Today I walk around"}, {"s": 215.46, "e": 218.89, "zh": "看这世界满目疮痍", "en": "See the world lying in ruins"}, {"s": 219.38, "e": 222.46, "zh": "我找到一个气球", "en": "I found a balloon"}, {"s": 223.03, "e": 227.26, "zh": "想起你，就让它飞走了", "en": "Think of you and let it fly away"}]}