{"vid": "hWTFG3J1CP8", "source": "deepgram", "model": "nova-3", "translation_model": "pool:[\"antigravity/gemini-3.8-flash\",\"codex/gpt-6-luna\",\"trae-cn/deepseek-v4.1-flash\",\"workbuddy-vps/cn:deepseek-v4.1-flash\"]", "translation_models": ["codex/gpt-6-luna", "antigravity/gemini-3.8-flash", "trae-cn/deepseek-v4.1-flash", "workbuddy-vps/cn:deepseek-v4.1-flash"], "translation_workers": {"codex/gpt-6-luna": 50, "antigravity/gemini-3.8-flash": 50, "trae-cn/deepseek-v4.1-flash": 20, "workbuddy-vps/cn:deepseek-v4.1-flash": 30}, "cues": [{"s": 1.52, "e": 3.04, "en": "To Moscow,", "zh": "来到莫斯科，"}, {"s": 3.12, "e": 6.08, "en": "I came seeking fortune,", "zh": "我本想寻找财富，"}, {"s": 7.52, "e": 10.32, "en": "but they're making me work", "zh": "他们却让我干活"}, {"s": 10.32, "e": 11.92, "en": "till I'm dead.", "zh": "直到累死。"}, {"s": 13.52, "e": 15.52, "en": "The bourgeoisie", "zh": "资产阶级"}, {"s": 15.52, "e": 16.95, "en": "have its own.", "zh": "坐拥一切。"}, {"s": 19.04, "e": 21.52, "en": "The tsar's putting gold", "zh": "沙皇在面包上"}, {"s": 21.52, "e": 22.88, "en": "on his bread.", "zh": "抹着金箔。"}, {"s": 25.03, "e": 27.35, "en": "The people of Moscow", "zh": "莫斯科的人民"}, {"s": 27.35, "e": 29.35, "en": "are hungry.", "zh": "饥肠辘辘。"}, {"s": 30.87, "e": 31.99, "en": "But then", "zh": "但若是我们……"}, {"s": 32.07, "e": 35.11, "en": "what a feast there could be", "zh": "那该是一场"}, {"s": 36.55, "e": 37.83, "en": "if we", "zh": "怎样的盛宴。"}, {"s": 52.28, "e": 55.48, "en": "I am the man who bridges", "zh": "我就是那个拼接砖块的人，"}, {"s": 55.48, "e": 59.4, "en": "the blocks that descend upon me from", "zh": "连接那些自上而下"}, {"s": 59.4, "e": 61.08, "en": "up above.", "zh": "掉落在我身上的方块。"}, {"s": 61.8, "e": 69.89, "en": "They come down and I spin them around till they fit in the ground like hand in glove.", "zh": "它们落下，我不断旋转，直到严丝合缝嵌入地面。"}, {"s": 70.22, "e": 71.02, "en": "Sometimes", "zh": "有时候"}, {"s": 71.02, "e": 75.25, "en": "it seems that two blocks is fine and the lines", "zh": "两块似乎刚刚好，消行的线条"}, {"s": 75.25, "e": 78.45, "en": "will be formed as they form.", "zh": "也会顺理成章地填满。"}, {"s": 78.94, "e": 82.12, "en": "Then I see that I have misjudged", "zh": "然后我发现自己看走眼了"}, {"s": 82.12, "e": 84.84, "en": "it. I should not have nudged it", "zh": "本不该去碰它的"}, {"s": 85.08, "e": 86.76, "en": "after all.", "zh": "终究还是错了。"}, {"s": 87.0, "e": 88.04, "en": "Can", "zh": "我"}, {"s": 88.04, "e": 88.76, "en": "I", "zh": "能否"}, {"s": 89.08, "e": 90.2, "en": "have", "zh": "拥有"}, {"s": 90.2, "e": 90.84, "en": "a", "zh": "一段"}, {"s": 91.08, "e": 92.36, "en": "long", "zh": "长久"}, {"s": 116.92, "e": 118.03, "en": "and love?", "zh": "又充满爱的生活？"}, {"s": 118.35, "e": 128.75, "en": "I work so hard in arranging the blocks, but the landlord and taxman bleed me cry. But the workers will rise, we will not compromise.", "zh": "我如此拼命地码放方块，地主和税官却榨干了我的血泪。但工人们终将觉醒，我们绝不妥协。"}, {"s": 128.83, "e": 131.47, "en": "For we know that the old regime", "zh": "因为我们深知旧体制"}, {"s": 131.47, "e": 132.19, "en": "must die.", "zh": "必将灭亡。"}, {"s": 132.89, "e": 133.69, "en": "Long", "zh": "万"}, {"s": 133.69, "e": 134.57, "en": "live", "zh": "岁"}, {"s": 134.57, "e": 136.17, "en": "Lanin", "zh": "列宁"}, {"s": 136.49, "e": 138.97, "en": "killed Azar.", "zh": "斩杀了沙皇。"}, {"s": 140.09, "e": 142.65, "en": "We salute", "zh": "我们致敬"}, {"s": 142.65, "e": 143.61, "en": "this", "zh": "这把"}, {"s": 143.61, "e": 144.49, "en": "sickle", "zh": "镰刀"}, {"s": 144.49, "e": 145.77, "en": "on soul.", "zh": "注入灵魂。"}, {"s": 147.04, "e": 153.37, "en": "I am the man who arranges the blocks that continue to fall from above.", "zh": "我就是那个码放方块的人，方块从上方不断坠落。"}, {"s": 153.53, "e": 160.32, "en": "The food on your plate now belongs to the state, a collective regime of peace and love.", "zh": "你盘中的食物如今归国家所有，一个充满和平与爱的集体政权。"}, {"s": 160.56, "e": 162.88, "en": "I have no choice in", "zh": "我别无选择"}, {"s": 260.36, "e": 262.12, "en": "But tomorrow,", "zh": "但明天，"}, {"s": 263.48, "e": 266.04, "en": "I think I'll stay", "zh": "我想我会待在"}, {"s": 266.12, "e": 267.56, "en": "in bed.", "zh": "床上。"}, {"s": 268.68, "e": 271.24, "en": "The winter is cold.", "zh": "冬天很冷。"}, {"s": 271.88, "e": 273.63, "en": "I've got plenty", "zh": "我有很多"}, {"s": 273.63, "e": 274.83, "en": "of gold", "zh": "金子"}, {"s": 276.08, "e": 277.92, "en": "and I'm standing", "zh": "而我正站着"}, {"s": 277.92, "e": 279.28, "en": "in line", "zh": "排队"}, {"s": 279.76, "e": 281.2, "en": "for a loaf", "zh": "等着领一块"}, {"s": 281.2, "e": 282.88, "en": "of bread.", "zh": "面包。"}, {"s": 285.44, "e": 286.4, "en": "Maybe", "zh": "也许"}, {"s": 286.48, "e": 289.52, "en": "we'd be", "zh": "我们会"}, {"s": 289.52, "e": 289.8, "en": "off", "zh": "好过些"}, {"s": 290.19, "e": 293.0, "en": "if we brought down", "zh": "如果我们推翻"}, {"s": 293.24, "e": 294.68, "en": "Gorbachev.", "zh": "戈尔巴乔夫。"}]}